{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.battery",
  "name": "Battery",
  "version": "0.1.3",
  "icon": "battery.100percent",
  "bucket": { "group": "System", "order": 10, "size": "M" },

  "entry": { "kind": "script", "runtime": "deno-ts@1" },
  "source": { "kind": "script", "output": "viewtree" },

  "refresh": { "onOpen": true, "interval": 300, "staleAfterSec": 300 },

  "permissions": {
    "exec": [
      {
        "command": "/usr/bin/pmset",
        "purpose": "Read the battery level and charging state",
        "allowedArgs": [["-g", "batt"]],
        "maxOutputBytes": 8192,
        "sensitiveOutput": false
      }
    ]
  },

  "appearance": {
    "accent": "green",
    "density": "compact"
  },

  "localizations": {
    "ko": {
      "Read the battery level and charging state": "배터리 잔량과 충전 상태 읽기",
      "Battery": "배터리"
    }
  }
}
