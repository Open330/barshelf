          }
        }
      }
    },
    "To follow a Focus: in Shortcuts, add a personal automation for when the Focus turns on, with the Open URLs action and this link. From Terminal: barshelf dock use \"%@\".": {
      "localizations": {
        "ko": {
          "stringUnit": {
