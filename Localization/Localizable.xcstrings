{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "\"%@\" is not a supported shortcut key.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 키는 단축키로 사용할 수 없습니다."
          }
        }
      }
    },
    "#RRGGBB": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "#RRGGBB"
          }
        }
      }
    },
    "%@ (line %d)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (line %2$d)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$d행)"
          }
        }
      }
    },
    "%@ (not on this Mac)": {
      "comment": "A sensor this Mac does not have",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이 Mac에 없음)"
          }
        }
      }
    },
    "%@ Copy": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사본"
          }
        }
      }
    },
    "%@ accent": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 강조 색상"
          }
        }
      }
    },
    "%@ and %@": {
      "comment": "A list of two items",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 및 %2$@"
          }
        }
      }
    },
    "%@ has no Apple Dock layout saved; switching to it leaves the Apple Dock as it is.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 저장된 Apple Dock 레이아웃이 없습니다. 이 프로필로 바꿔도 Apple Dock은 그대로입니다."
          }
        }
      }
    },
    "%@ is included more than once.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 두 번 이상 포함되어 있습니다."
          }
        }
      }
    },
    "%@ is taken": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사용 중"
          }
        }
      }
    },
    "%@ needs your permission to run.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 위젯을 실행하려면 권한이 필요합니다."
          }
        }
      }
    },
    "%@ ready": {
      "comment": "A required tool, e.g. Deno ready",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 준비됨"
          }
        }
      }
    },
    "%@ s": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@초"
          }
        }
      }
    },
    "%@ stepper": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 스테퍼"
          }
        }
      }
    },
    "%@ was found on your Mac": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 %@을(를) 찾았습니다"
          }
        }
      }
    },
    "%@ widget": {
      "comment": "Accessibility: widget type, e.g. Command widget",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 위젯"
          }
        }
      }
    },
    "%@ · version %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · version %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 버전 %2$@"
          }
        }
      }
    },
    "%@ — checking…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 확인 중…"
          }
        }
      }
    },
    "%@ — installed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 설치됨"
          }
        }
      }
    },
    "%@ — not installed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 설치되지 않음"
          }
        }
      }
    },
    "%@, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%@, and %@": {
      "comment": "The end of a list of three or more items: the leading items, then the last one",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, and %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 및 %2$@"
          }
        }
      }
    },
    "%@, and %lld more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, and %2$lld more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 외 %lld개"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld more pinned — only %lld fit here. Show": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld more pinned — only %2$lld fit here. Show"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 위젯 %1$lld개 더 있음 — 여기에는 %2$lld개만 표시됩니다. 보기"
          }
        }
      }
    },
    "%lld more…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 더…"
          }
        }
      }
    },
    "%lld ms": {
      "comment": "A duration in milliseconds",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldms"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld of %lld widgets": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld widgets"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 %2$lld개 중 %1$lld개"
          }
        }
      }
    },
    "%lld ok · %lld failed · %@": {
      "comment": "Refresh counts: successful, failed, and how long the last one took",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld ok · %2$lld failed · %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성공 %1$lld · 실패 %2$lld · %3$@"
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "%lld widgets": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 %lld개"
          }
        }
      }
    },
    "%lld widgets installed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 %lld개 설치됨"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld. %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. %2$@"
          }
        }
      }
    },
    "(run the command to preview)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(미리 보려면 명령을 실행하십시오)"
          }
        }
      }
    },
    ", ": {
      "comment": "Separator between list items",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ", "
          }
        }
      }
    },
    "0": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0"
          }
        }
      }
    },
    "1": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1"
          }
        }
      }
    },
    "1 of 3": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1/3"
          }
        }
      }
    },
    "100": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100"
          }
        }
      }
    },
    "2": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2"
          }
        }
      }
    },
    "20:53": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "20:53"
          }
        }
      }
    },
    "3": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3"
          }
        }
      }
    },
    "80%": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "80%"
          }
        }
      }
    },
    "A command this widget needs isn’t installed on this Mac.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯에 필요한 명령이 이 Mac에 설치되어 있지 않습니다."
          }
        }
      }
    },
    "A confirmation always appears; this adds a sound.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 표시는 항상 나타나며, 이 옵션은 소리를 추가합니다."
          }
        }
      }
    },
    "A dock for apps, folders, and widgets, with profiles to switch between.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱·폴더·위젯을 올리는 독. 프로필로 구성을 바꿀 수 있습니다."
          }
        }
      }
    },
    "A graph needs the item's own place in the menu bar; sharing the BarShelf icon, it shows text only.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래프는 메뉴 막대에 별도 항목이 있어야 표시됩니다. BarShelf 아이콘을 공유하면 텍스트만 표시됩니다."
          }
        }
      }
    },
    "A newer version is available in the registry": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레지스트리에 새 버전이 있습니다"
          }
        }
      }
    },
    "A right click always opens the item's menu, which can still show the card.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 클릭은 항상 항목의 메뉴를 열며, 그 메뉴에서 카드를 볼 수 있습니다."
          }
        }
      }
    },
    "A single compact line.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간결한 한 줄입니다."
          }
        }
      }
    },
    "A sturdier bar with names under icons, and widgets as full cards.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 아래에 이름이 붙는 단단한 막대. 위젯은 전체 카드로 보입니다."
          }
        }
      }
    },
    "A sturdier bar with names under icons; roomy for widgets.": {
      "extractionState": "stale",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 아래에 이름이 붙는 단단한 막대. 위젯을 올리기 좋습니다."
          }
        }
      }
    },
    "A web page to open from the dock.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독에서 열 웹 페이지입니다."
          }
        }
      }
    },
    "A widget can also show its reading right in the menu bar — a battery level, CPU load, a temperature.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯은 배터리 잔량, CPU 부하, 온도 같은 값을 메뉴 막대에 바로 표시할 수도 있습니다."
          }
        }
      }
    },
    "A widget can only run commands, use the network, or read files it declared, and only after you allow it. Revoking stops the widget until you allow it again on its card. Copies of a widget share its permissions.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯은 선언한 명령 실행, 네트워크 사용, 파일 읽기만 할 수 있으며, 그것도 사용자가 허용한 후에만 가능합니다. 권한을 취소하면 카드에서 다시 허용할 때까지 위젯이 멈춥니다. 위젯의 복사본은 원본과 권한을 공유합니다."
          }
        }
      }
    },
    "A widget that needs to run a command or reach the network asks first, on its card.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령을 실행하거나 네트워크에 접근해야 하는 위젯은 먼저 카드에서 허락을 구합니다."
          }
        }
      }
    },
    "A widget with id \"%@\" already exists. Change the name/id or remove the existing widget first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ID가 \"%@\"인 위젯이 이미 있습니다. 이름/ID를 바꾸거나 기존 위젯을 먼저 제거하십시오."
          }
        }
      }
    },
    "About": {
      "comment": "Widget inspector tab",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "Accent": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 색상"
          }
        }
      }
    },
    "Accessibility access was removed. Grant access and enable the extension again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 접근 권한이 제거되었습니다. 접근을 허용한 후 확장을 다시 켜십시오."
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성"
          }
        }
      }
    },
    "Activity log": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동 기록"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가"
          }
        }
      }
    },
    "Add Link": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 추가"
          }
        }
      }
    },
    "Add Profile…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 추가…"
          }
        }
      }
    },
    "Add Widget": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 추가"
          }
        }
      }
    },
    "Add Widget…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 추가…"
          }
        }
      }
    },
    "Add a second copy with its own settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도 설정을 가진 사본 추가"
          }
        }
      }
    },
    "Add a widget from the Gallery, or build your own.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갤러리에서 위젯을 추가하거나 직접 만드십시오."
          }
        }
      }
    },
    "Add column": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열 추가"
          }
        }
      }
    },
    "Add meter": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미터 추가"
          }
        }
      }
    },
    "Add to Dock": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독에 추가"
          }
        }
      }
    },
    "Add ⌘, ⌥, ⌃, or ⇧ so the shortcut doesn't fire while you type.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 중에 단축키가 실행되지 않도록 ⌘, ⌥, ⌃ 또는 ⇧를 추가하십시오."
          }
        }
      }
    },
    "Adds the Apple Dock's apps, folders, and files to this profile.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Dock의 앱·폴더·파일을 이 프로필에 추가합니다."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급"
          }
        }
      }
    },
    "Alerts": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경보"
          }
        }
      }
    },
    "Align left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 정렬"
          }
        }
      }
    },
    "Align right": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 정렬"
          }
        }
      }
    },
    "Alignment places the label and value rows. Left-aligned numbers start where the label does; the unit moves as 9 becomes 10.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정렬은 레이블 행과 값 행의 위치를 정합니다. 왼쪽 정렬된 숫자는 레이블과 같은 위치에서 시작하며, 9가 10이 되면 단위가 움직입니다."
          }
        }
      }
    },
    "Alignment places the label and value rows. Right-aligned numbers keep the last digit and the unit still as 9 becomes 10.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정렬은 레이블 행과 값 행의 위치를 정합니다. 오른쪽 정렬된 숫자는 9가 10이 되어도 마지막 자릿수와 단위가 움직이지 않습니다."
          }
        }
      }
    },
    "All": {
      "comment": "Gallery filter: every widget type",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두"
          }
        }
      }
    },
    "All Categories": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 카테고리"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용"
          }
        }
      }
    },
    "Allow BarShelf in System Settings → Privacy & Security → Accessibility, then enable the extension again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 BarShelf를 허용한 후 확장을 다시 켜십시오."
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨"
          }
        }
      }
    },
    "Alongside the Apple Dock": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Dock과 함께"
          }
        }
      }
    },
    "An SF Symbol name or an emoji. Uncheck for no icon.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol 이름 또는 이모지입니다. 아이콘을 없애려면 선택 해제하십시오."
          }
        }
      }
    },
    "An existing install will be replaced. Changed permissions must be approved again before they take effect.": {
      "localizations": {
