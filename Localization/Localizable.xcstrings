            "value": "BarShelf가 업데이트되었지만 시작되지 않음"
          }
        }
      }
    },
    "BarShelf, needs attention": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BarShelf, 확인 필요"
          }
