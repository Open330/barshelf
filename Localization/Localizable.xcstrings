          }
        }
      }
    },
    "Cannot register %@. Quit Hammerspoon or change the conflicting shortcut, then try again (%d).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Cannot register %1$@. Quit Hammerspoon or change the conflicting shortcut, then try again (%2$d)."
