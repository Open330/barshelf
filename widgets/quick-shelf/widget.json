{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.quick-shelf",
  "name": "Quick Shelf",
  "version": "0.2.0",
  "icon": "square.grid.2x2.fill",
  "bucket": {
    "group": "Productivity",
    "order": 20,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": null,
    "staleAfterSec": 86400
  },
  "settings": [
    {
      "key": "appName",
      "title": "Favorite app label",
      "type": "string",
      "default": "Notes"
    },
    {
      "key": "appIdentifier",
      "title": "Favorite app (bundle ID, name or .app path)",
      "type": "string",
      "default": "com.apple.Notes"
    },
    {
      "key": "folderName",
      "title": "Favorite folder label",
      "type": "string",
      "default": "Downloads"
    },
    {
      "key": "folderPath",
      "title": "Favorite folder path",
      "type": "directory",
      "default": "~/Downloads"
    },
    {
      "key": "siteName",
      "title": "Favorite website label",
      "type": "string",
      "default": "GitHub"
    },
    {
      "key": "siteURL",
      "title": "Favorite website URL",
      "type": "string",
      "default": "https://github.com"
    }
  ],
  "appearance": {
    "accent": "purple",
    "density": "compact"
  },
  "localizations": {
    "ko": {
      "Quick Shelf": "빠른 선반",
      "Favorite app label": "즐겨 쓰는 앱 이름",
      "Favorite folder label": "즐겨 쓰는 폴더 이름",
      "Favorite folder path": "즐겨 쓰는 폴더 경로",
      "Favorite website label": "즐겨 쓰는 웹사이트 이름",
      "Favorite website URL": "즐겨 쓰는 웹사이트 URL",
      "Find a shortcut": "바로가기 찾기",
      "App": "앱",
      "Calendar": "캘린더",
      "Favorite app": "즐겨 쓰는 앱",
      "Folder": "폴더",
      "Applications": "응용 프로그램",
      "Website": "웹사이트",
      "Open apps, folders, and websites": "앱, 폴더, 웹사이트 열기",
      "Favorite app (bundle ID, name or .app path)": "즐겨 쓰는 앱 (번들 ID, 이름 또는 .app 경로)"
    }
  }
}
