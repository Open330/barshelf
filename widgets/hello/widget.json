{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.hello",
  "name": "Hello",
  "version": "0.1.3",
  "icon": "hand.wave",
  "bucket": { "group": "Everyday", "order": 10, "size": "S" },

  "entry": { "kind": "exec" },
  "source": {
    "kind": "exec",
    "command": ["./hello.sh"],
    "timeoutMs": 5000,
    "output": "viewtree"
  },

  "refresh": { "onOpen": true, "interval": 60, "staleAfterSec": 30 },
  "permissions": { "exec": [{ "command": "./hello.sh", "purpose": "Show the time from the widget’s own script", "allowedArgs": [[]] }] },

  "localizations": {
    "ko": {
      "Show the time from the widget’s own script": "위젯에 들어 있는 스크립트로 현재 시각 보여 주기",
      "Hello": "안녕하세요"
    }
  }
}
