{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.clipboard-shelf",
  "name": "Clipboard Shelf",
  "version": "0.2.1",
  "icon": "clipboard.fill",
  "bucket": { "group": "Everyday", "order": 40, "size": "M" },

  "entry": { "kind": "script", "runtime": "deno-ts@1" },
  "source": { "kind": "script", "output": "viewtree" },

  "refresh": {
    "onOpen": true,
    "interval": 5,
    "staleAfterSec": 5,
    "runInBackground": false
  },

  "permissions": {
    "exec": [
      {
        "command": "/usr/bin/pbpaste",
        "purpose": "Read what you copy",
        "allowedArgs": [[]],
        "maxOutputBytes": 65536,
        "sensitiveOutput": true
      }
    ]
  },

  "settings": [
    {
      "key": "historyLimit",
      "type": "integer",
      "title": "History items",
      "min": 3,
      "max": 20,
      "default": 8
    },
    {
      "key": "collectInBackground",
      "type": "boolean",
      "title": "Keep collecting while the popup is closed",
      "default": true
    },
    {
      "key": "clearAfterSec",
      "type": "integer",
      "title": "Clear clipboard after re-copy (seconds, 0 = never)",
      "min": 0,
      "max": 300,
      "default": 0
    }
  ],

  "appearance": {
    "accent": "purple",
    "density": "compact",
    "cardStyle": "plain"
  },

  "localizations": {
    "ko": {
      "Read what you copy": "복사한 내용 읽기",
      "Clipboard Shelf": "클립보드 선반",
      "History items": "기록 항목 수",
      "Clear clipboard after re-copy (seconds, 0 = never)": "다시 복사한 뒤 클립보드 지우기(초, 0 = 지우지 않음)",
      "Keep collecting while the popup is closed": "팝업이 닫혀 있어도 계속 수집"
    }
  }
}
