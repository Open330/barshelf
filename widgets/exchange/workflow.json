{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Exchange rate over open.er-api.com (no key, daily rates). The pair is two settings; the rate is formatted with thousands separators by integer group math (the DSL has no number formatter). The source is optional, and an unknown pair (result:error) has its own state.",
  "sources": {
    "data": {
      "use": "http",
      "optional": true,
      "with": {
        "url": "https://open.er-api.com/v6/latest/${coalesce(settings.base, 'USD')}"
      }
    }
  },
  "transforms": {
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "base": {
      "use": "assign",
      "from": "coalesce(settings.base, 'USD')"
    },
    "quote": {
      "use": "assign",
      "from": "coalesce(settings.quote, 'KRW')"
    },
    "rate": {
      "use": "assign",
      "from": "number(get(sources.data.rates, transforms.quote))"
    },
    "ok": {
      "use": "assign",
      "from": "and(eq(sources.data.result, 'success'), ne(transforms.rate, null))"
    },
    "sym": {
      "use": "assign",
      "from": "switch(transforms.quote, 'USD', '$', 'EUR', '€', 'JPY', '¥', 'GBP', '£', 'CNY', 'CN¥', 'KRW', '₩', 'CAD', 'C$', 'AUD', 'A$', 'CHF', '', 'HKD', 'HK$', 'SGD', 'S$', 'TWD', 'NT$', '')"
    },
    "cents": {
      "use": "assign",
      "from": "round(mul(transforms.rate, 100))"
    },
    "ip0": {
      "use": "assign",
      "from": "sub(round(add(div(transforms.cents, 100), 0.5)), 1)"
    },
    "dec": {
      "use": "assign",
      "from": "sub(transforms.cents, mul(transforms.ip0, 100))"
    },
    "ipI": {
      "use": "assign",
      "from": "round(transforms.ip0)"
    },
    "ipG3": {
      "use": "assign",
      "from": "sub(round(add(div(transforms.ipI, 1000000000), 0.5)), 1)"
    },
    "ipG2": {
      "use": "assign",
      "from": "sub(sub(round(add(div(transforms.ipI, 1000000), 0.5)), 1), mul(transforms.ipG3, 1000))"
    },
    "ipG1": {
      "use": "assign",
      "from": "sub(sub(round(add(div(transforms.ipI, 1000), 0.5)), 1), mul(sub(round(add(div(transforms.ipI, 1000000), 0.5)), 1), 1000))"
    },
    "ipG0": {
      "use": "assign",
      "from": "sub(transforms.ipI, mul(sub(round(add(div(transforms.ipI, 1000), 0.5)), 1), 1000))"
    },
    "ipText": {
      "use": "assign",
      "from": "if(gte(transforms.ipI, 1000000000), concat(string(transforms.ipG3), ',', concat(if(lt(transforms.ipG2, 10), '00', if(lt(transforms.ipG2, 100), '0', '')), string(transforms.ipG2)), ',', concat(if(lt(transforms.ipG1, 10), '00', if(lt(transforms.ipG1, 100), '0', '')), string(transforms.ipG1)), ',', concat(if(lt(transforms.ipG0, 10), '00', if(lt(transforms.ipG0, 100), '0', '')), string(transforms.ipG0))), if(gte(transforms.ipI, 1000000), concat(string(transforms.ipG2), ',', concat(if(lt(transforms.ipG1, 10), '00', if(lt(transforms.ipG1, 100), '0', '')), string(transforms.ipG1)), ',', concat(if(lt(transforms.ipG0, 10), '00', if(lt(transforms.ipG0, 100), '0', '')), string(transforms.ipG0))), if(gte(transforms.ipI, 1000), concat(string(transforms.ipG1), ',', concat(if(lt(transforms.ipG0, 10), '00', if(lt(transforms.ipG0, 100), '0', '')), string(transforms.ipG0))), string(transforms.ipI))))"
    },
    "number": {
      "use": "assign",
      "from": "if(lt(transforms.rate, 1), string(round(transforms.rate, 6)), concat(transforms.ipText, '.', concat(if(lt(transforms.dec, 10), '0', ''), string(transforms.dec))))"
    },
    "short": {
      "use": "assign",
      "from": "if(lt(transforms.rate, 1), string(round(transforms.rate, 4)), if(gte(transforms.rate, 100), transforms.ipText, concat(transforms.ipText, '.', concat(if(lt(transforms.dec, 10), '0', ''), string(transforms.dec)))))"
    },
    "text": {
      "use": "assign",
      "from": "if(eq(transforms.sym, ''), concat(transforms.number, ' ', transforms.quote), concat(transforms.sym, transforms.number))"
    },
    "menu": {
      "use": "assign",
      "from": "if(eq(transforms.sym, ''), concat(transforms.short, ' ', transforms.quote), concat(transforms.sym, transforms.short))"
    },
    "updated": {
      "use": "assign",
      "from": "date.clock(mul(number(sources.data.time_last_update_unix), 1000))"
    },
    "tip": {
      "use": "assign",
      "from": "if(transforms.ok, concat('1 ', transforms.base, ' = ', transforms.text), if(transforms.ko, '환율 정보 없음', 'No exchange rate'))"
    }
  },
  "view": {
    "switch": "${if(eq(errors.data, null), if(transforms.ok, 'ok', 'unknown'), errors.data.kind)}",
    "cases": {
      "ok": {
        "action": {
          "type": "openURL",
          "url": "https://www.xe.com/currencyconverter/convert/?Amount=1&From=${transforms.base}&To=${transforms.quote}"
        },
        "type": "vstack",
        "spacing": 2,
        "children": [
          {
            "type": "text",
            "text": "${transforms.base} → ${transforms.quote}",
            "role": "caption",
            "foreground": "secondary"
          },
          {
            "type": "text",
            "text": "${transforms.text}",
            "size": 32,
            "role": "title",
            "monospacedDigit": true,
            "lineLimit": 1
          },
          {
            "type": "text",
            "text": "per 1 ${transforms.base} · ${transforms.updated}",
            "role": "caption",
            "foreground": "secondary",
            "lineLimit": 1
          }
        ]
      },
      "offline": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "wifi.slash",
            "title": "You’re offline",
            "subtitle": "Connect to the internet, then try again."
          },
          {
            "type": "text",
            "text": "${errors.data.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "timeout": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "hourglass",
            "title": "The rate service didn’t answer in time",
            "subtitle": "It may be busy. Try again in a moment."
          },
          {
            "type": "text",
            "text": "${errors.data.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "rateLimited": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "tortoise",
            "title": "The rate service is limiting requests",
            "subtitle": "The free service allows only so many. It refreshes again on its own."
          },
          {
            "type": "text",
            "text": "${errors.data.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "unknown": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "questionmark.circle",
            "title": "No rate for this pair",
            "subtitle": "Pick another currency in this widget’s settings (⋯ ▸ Settings)."
          },
          {
            "type": "text",
            "text": "${errors.data.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      }
    },
    "default": {
      "type": "vstack",
      "spacing": 6,
      "children": [
        {
          "type": "empty",
          "icon": "exclamationmark.icloud",
          "title": "The rate service is unavailable",
          "subtitle": "Try again in a moment."
        },
        {
          "type": "text",
          "text": "${errors.data.message}",
          "role": "caption",
          "foreground": "tertiary",
          "lineLimit": 2,
          "desktopRole": "hide"
        },
        {
          "type": "hstack",
          "children": [
            {
              "type": "spacer"
            },
            {
              "type": "button",
              "title": "Try Again",
              "icon": "arrow.clockwise",
              "action": {
                "type": "refresh"
              }
            },
            {
              "type": "spacer"
            }
          ]
        }
      ]
    }
  },
  "status": {
    "label": "${if(transforms.ok, transforms.menu, '')}",
    "tooltip": "${transforms.tip}"
  }
}
