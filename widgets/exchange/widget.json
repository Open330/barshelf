{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.exchange",
  "name": "Exchange",
  "version": "0.1.2",
  "icon": "dollarsign.circle.fill",
  "bucket": { "group": "Demo", "order": 14, "size": "S" },

  "entry": { "kind": "workflow", "main": "workflow.json" },

  "refresh": { "onOpen": true, "interval": 3600, "staleAfterSec": 3600 },

  "permissions": {
    "network": ["open.er-api.com"]
  },

  "appearance": {
    "accent": "green"
  },

  "localizations": {
    "ko": {
      "Exchange": "환율",
      "per $1": "1달러당",
      "USD to KRW: ${string(sources.data.rates.KRW)}": "달러-원 환율: ${string(sources.data.rates.KRW)}"
    }
  }
}
