{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.system",
  "name": "System",
  "version": "0.5.0",
  "icon": "cpu.fill",
  "bucket": {
    "group": "System",
    "order": 11,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 2,
    "staleAfterSec": 2
  },
  "statusItem": {
    "mode": "text",
    "icon": "cpu.fill"
  },
  "permissions": {
    "system": [
      "cpu",
      "memory",
      "disk"
    ]
  },
  "settings": [
    {
      "key": "menuBarMetric",
      "title": "Menu bar shows",
      "type": "enum",
      "default": "cpu",
      "options": [
        "cpu",
        "cpuUser",
        "cpuSystem",
        "cpuCore",
        "memory",
        "pressure",
        "swap",
        "disk",
        "diskFree",
        "diskRead",
        "diskWrite"
      ],
      "optionTitles": [
        "CPU",
        "CPU user",
        "CPU system",
        "Busiest core",
        "Memory",
        "Memory pressure",
        "Swap used",
        "Disk used",
        "Disk free",
        "Disk read",
        "Disk write"
      ]
    },
    {
      "key": "menuBarSecondary",
      "title": "Also show",
      "type": "enum",
      "default": "none",
      "options": [
        "none",
        "cpu",
        "cpuUser",
        "cpuSystem",
        "cpuCore",
        "memory",
        "pressure",
        "swap",
        "disk",
        "diskFree",
        "diskRead",
        "diskWrite"
      ],
      "optionTitles": [
        "Nothing",
        "CPU",
        "CPU user",
        "CPU system",
        "Busiest core",
        "Memory",
        "Memory pressure",
        "Swap used",
        "Disk used",
        "Disk free",
        "Disk read",
        "Disk write"
      ]
    },
    {
      "key": "menuBarMemoryDisplay",
      "title": "RAM menu bar value",
      "type": "enum",
      "default": "percent",
      "options": [
        "percent",
        "used",
        "available"
      ],
      "optionTitles": [
        "Percent used",
        "Memory used",
        "Memory available"
      ]
    }
  ],
  "appearance": {
    "accent": "purple"
  }
}
