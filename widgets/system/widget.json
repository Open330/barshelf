{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.system",
  "name": "System",
  "version": "0.6.0",
  "minHostVersion": "0.7.13",
  "icon": "cpu.fill",
  "bucket": {
    "group": "System",
    "order": 11,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 2,
    "staleAfterSec": 2
  },
  "statusItem": {
    "mode": "text",
    "icon": "cpu.fill"
  },
  "permissions": {
    "system": [
      "cpu",
      "memory",
      "disk",
      "processes"
    ],
    "quitApps": true
  },
  "settings": [
    {
      "key": "menuBarMetric",
      "title": "Menu bar shows",
      "type": "enum",
      "default": "cpu",
      "options": [
        "cpu",
        "cpuUser",
        "cpuSystem",
        "cpuCore",
        "memory",
        "pressure",
        "swap",
        "disk",
        "diskFree",
        "diskRead",
        "diskWrite"
      ],
      "optionTitles": [
        "CPU",
        "CPU user",
        "CPU system",
        "Busiest core",
        "Memory",
        "Memory pressure",
        "Swap used",
        "Disk used",
        "Disk free",
        "Disk read",
        "Disk write"
      ]
    },
    {
      "key": "menuBarSecondary",
      "title": "Also show",
      "type": "enum",
      "default": "none",
      "options": [
        "none",
        "cpu",
        "cpuUser",
        "cpuSystem",
        "cpuCore",
        "memory",
        "pressure",
        "swap",
        "disk",
        "diskFree",
        "diskRead",
        "diskWrite"
      ],
      "optionTitles": [
        "Nothing",
        "CPU",
        "CPU user",
        "CPU system",
        "Busiest core",
        "Memory",
        "Memory pressure",
        "Swap used",
        "Disk used",
        "Disk free",
        "Disk read",
        "Disk write"
      ]
    },
    {
      "key": "menuBarMemoryDisplay",
      "title": "RAM menu bar value",
      "type": "enum",
      "default": "percent",
      "options": [
        "percent",
        "used",
        "available"
      ],
      "optionTitles": [
        "Percent used",
        "Memory used",
        "Memory available"
      ]
    }
  ],
  "appearance": {
    "accent": "purple"
  },
  "localizations": {
    "ko": {
      "System": "시스템",
      "Menu bar shows": "메뉴 막대에 표시",
      "CPU user": "CPU 사용자",
      "CPU system": "CPU 시스템",
      "Busiest core": "가장 바쁜 코어",
      "Memory": "메모리",
      "Memory pressure": "메모리 압력",
      "Swap used": "사용 중인 스왑",
      "Disk used": "디스크 사용률",
      "Disk free": "디스크 여유 공간",
      "Disk read": "디스크 읽기",
      "Disk write": "디스크 쓰기",
      "Also show": "함께 표시",
      "Nothing": "없음",
      "RAM menu bar value": "메뉴 막대의 메모리 값",
      "Percent used": "사용률",
      "Memory used": "사용 중인 메모리",
      "Memory available": "사용 가능한 메모리",
      "Disk": "디스크",
      "${if(transforms.plainTooltip, '', concat(transforms.label1, ' ', transforms.text1, if(transforms.hasSecond, concat(' · ', transforms.label2, ' ', transforms.text2), ''), '\n'))}CPU ${string(round(number(sources.data.cpu.usage), 0))}% · Memory ${string(round(number(sources.data.memory.usage), 0))}% · Disk ${string(round(number(sources.data.disk.usage), 0))}%": "${if(transforms.plainTooltip, '', concat(transforms.label1, ' ', transforms.text1, if(transforms.hasSecond, concat(' · ', transforms.label2, ' ', transforms.text2), ''), '\n'))}CPU ${string(round(number(sources.data.cpu.usage), 0))}% · 메모리 ${string(round(number(sources.data.memory.usage), 0))}% · 디스크 ${string(round(number(sources.data.disk.usage), 0))}%",
      "User ${string(round(number(sources.data.cpu.user), 0))}% · System ${string(round(number(sources.data.cpu.system), 0))}%": "사용자 ${string(round(number(sources.data.cpu.user), 0))}% · 시스템 ${string(round(number(sources.data.cpu.system), 0))}%",
      "Load average (1 min)": "평균 부하 (1분)",
      "${string(round(div(number(sources.data.memory.used), 1000000000), 1))} GB of ${string(round(div(number(sources.data.memory.total), 1000000000), 1))} GB": "${string(round(div(number(sources.data.memory.total), 1000000000), 1))} GB 중 ${string(round(div(number(sources.data.memory.used), 1000000000), 1))} GB",
      "Pressure": "압력",
      "${string(round(div(number(sources.data.disk.free), 1000000000), 1))} GB free": "${string(round(div(number(sources.data.disk.free), 1000000000), 1))} GB 남음",
      "Using the most CPU": "CPU를 많이 쓰는 앱",
      "Quit ${proc.name}": "${proc.name} 종료",
      "User": "사용자"
    }
  }
}
