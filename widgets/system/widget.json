{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.system",
  "name": "System",
  "version": "0.2.0",
  "icon": "cpu.fill",
  "bucket": { "group": "System", "order": 11, "size": "M" },

  "entry": { "kind": "workflow", "main": "workflow.json" },

  "refresh": { "onOpen": true, "interval": 2, "staleAfterSec": 2 },

  "statusItem": { "mode": "text", "icon": "cpu.fill" },

  "permissions": {
    "system": ["cpu", "memory", "disk"]
  },

  "appearance": {
    "accent": "purple"
  }
}
