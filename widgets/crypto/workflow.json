{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Crypto prices from CoinGecko's public /coins/markets (no key; an array, so the coins list can be any length). Prices get thousands separators through integer group math, since the DSL has no number formatter. The optional 7-day chart comes in the same call (sparkline=true). The source is optional, so CoinGecko's free-tier 429 or being offline has its own state.",
  "sources": {
    "data": {
      "use": "http",
      "with": {
        "url": "https://api.coingecko.com/api/v3/coins/markets?vs_currency=${coalesce(settings.currency, 'usd')}&ids=${coalesce(settings.coins, 'bitcoin,ethereum')}&price_change_percentage=24h&sparkline=${if(settings.sparkline, 'true', 'false')}",
        "headers": {
          "Accept": "application/json"
        }
      },
      "optional": true
    }
  },
  "transforms": {
    "sym": {
      "use": "assign",
      "from": "switch(coalesce(settings.currency, 'usd'), 'usd', '$', 'krw', '₩', 'eur', '€', 'jpy', '¥', 'gbp', '£', '')"
    },
    "calc": {
      "use": "template",
      "with": {
        "forEach": "$.sources.data",
        "as": "c",
        "template": {
          "id": "${c.id}",
          "name": "${c.name}",
          "symbol": "${c.symbol}",
          "p": "${number(c.current_price)}",
          "a": "${round(number(c.current_price))}",
          "g3": "${round(sub(div(round(number(c.current_price)), 1000000000), 0.4999999))}",
          "g2": "${sub(round(sub(div(round(number(c.current_price)), 1000000), 0.4999999)), mul(round(sub(div(round(number(c.current_price)), 1000000000), 0.4999999)), 1000))}",
          "g1": "${sub(round(sub(div(round(number(c.current_price)), 1000), 0.4999999)), mul(round(sub(div(round(number(c.current_price)), 1000000), 0.4999999)), 1000))}",
          "g0": "${sub(round(number(c.current_price)), mul(round(sub(div(round(number(c.current_price)), 1000), 0.4999999)), 1000))}",
          "ch": "${if(eq(number(c.price_change_percentage_24h), null), null, round(number(c.price_change_percentage_24h), 2))}",
          "spark": "${c.sparkline_in_7d.price}"
        }
      }
    },
    "rows": {
      "use": "template",
      "with": {
        "forEach": "$.transforms.calc",
        "as": "r",
        "template": {
          "id": "coin-${r.id}",
          "coin": "${r.id}",
          "name": "${r.name}",
          "symbol": "${r.symbol}",
          "price": "${if(eq(r.p, null), '—', concat(transforms.sym, if(gte(r.a, 1000000000), concat(string(r.g3), ',', concat(if(lt(r.g2, 10), '00', if(lt(r.g2, 100), '0', '')), string(r.g2)), ',', concat(if(lt(r.g1, 10), '00', if(lt(r.g1, 100), '0', '')), string(r.g1)), ',', concat(if(lt(r.g0, 10), '00', if(lt(r.g0, 100), '0', '')), string(r.g0))), if(gte(r.a, 1000000), concat(string(r.g2), ',', concat(if(lt(r.g1, 10), '00', if(lt(r.g1, 100), '0', '')), string(r.g1)), ',', concat(if(lt(r.g0, 10), '00', if(lt(r.g0, 100), '0', '')), string(r.g0))), if(gte(r.a, 1000), concat(string(r.g1), ',', concat(if(lt(r.g0, 10), '00', if(lt(r.g0, 100), '0', '')), string(r.g0))), if(gte(r.p, 1), string(round(r.p, 2)), string(round(r.p, 6))))))))}",
          "change": "${if(eq(r.ch, null), '—', concat(if(gt(r.ch, 0), '+', ''), string(r.ch), '%'))}",
          "tone": "${if(eq(r.ch, null), 'secondary', if(gt(r.ch, 0), 'good', if(lt(r.ch, 0), 'danger', 'secondary')))}",
          "arrow": "${if(eq(r.ch, null), 'minus', if(gt(r.ch, 0), 'arrow.up.right', if(lt(r.ch, 0), 'arrow.down.right', 'minus')))}",
          "spark": "${r.spark}",
          "ticker": "${switch(r.symbol, 'btc', 'BTC', 'eth', 'ETH', 'sol', 'SOL', 'xrp', 'XRP', 'bnb', 'BNB', 'doge', 'DOGE', 'ada', 'ADA', 'trx', 'TRX', 'ton', 'TON', 'dot', 'DOT', 'ltc', 'LTC', 'link', 'LINK', 'avax', 'AVAX', 'usdt', 'USDT', 'usdc', 'USDC', 'xlm', 'XLM', 'bch', 'BCH', 'sui', 'SUI', 'shib', 'SHIB', 'near', 'NEAR', 'matic', 'MATIC', 'pol', 'POL', 'atom', 'ATOM', 'uni', 'UNI', 'etc', 'ETC', 'apt', 'APT', 'hbar', 'HBAR', 'arb', 'ARB', 'op', 'OP', r.symbol)}",
          "short": "${if(eq(r.p, null), '', if(gte(r.a, 1000000), concat(transforms.sym, string(round(div(r.a, 1000000), 1)), 'M'), r.price))}"
        }
      }
    },
    "picked": {
      "use": "filter",
      "from": "$.transforms.rows",
      "with": {
        "field": "coin",
        "equals": "${coalesce(settings.menuBarCoin, 'bitcoin')}"
      }
    },
    "menu": {
      "use": "assign",
      "from": "coalesce(get(transforms.picked, 0), get(transforms.rows, 0))"
    },
    "first": {
      "use": "assign",
      "from": "get(sources.data, 0)"
    },
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "tip": {
      "use": "assign",
      "from": "if(eq(transforms.menu, null), if(eq(errors.data, null), '', if(transforms.ko, 'CoinGecko 가격 정보 없음', 'No prices from CoinGecko')), if(transforms.ko, concat(transforms.menu.name, ' ', transforms.menu.price, ' (24시간 ', transforms.menu.change, ')'), concat(transforms.menu.name, ' ', transforms.menu.price, ' (', transforms.menu.change, ', 24h)')))"
    }
  },
  "view": {
    "switch": "${if(eq(errors.data, null), if(eq(count(transforms.rows), 0), 'none', 'ok'), errors.data.kind)}",
    "cases": {
      "ok": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "vstack",
            "spacing": 6,
            "children": {
              "forEach": "$.transforms.rows",
              "as": "row",
              "template": {
                "type": "vstack",
                "id": "${row.id}",
                "spacing": 2,
                "desktopRole": "item",
                "action": {
                  "type": "openURL",
                  "url": "https://www.coingecko.com/en/coins/${row.coin}"
                },
                "children": [
                  {
                    "type": "hstack",
                    "spacing": 8,
                    "children": [
                      {
                        "type": "vstack",
                        "spacing": 0,
                        "widthFill": true,
                        "children": [
                          {
                            "type": "text",
                            "text": "${row.name}",
                            "role": "body",
                            "lineLimit": 1,
                            "desktopRole": "title"
                          },
                          {
                            "type": "text",
                            "text": "${row.symbol}",
                            "role": "caption",
                            "foreground": "secondary",
                            "lineLimit": 1
                          }
                        ]
                      },
                      {
                        "type": "vstack",
                        "spacing": 0,
                        "children": [
                          {
                            "type": "text",
                            "text": "${row.price}",
                            "size": 17,
                            "role": "title",
                            "monospacedDigit": true,
                            "lineLimit": 1,
                            "desktopRole": "value"
                          },
                          {
                            "type": "hstack",
                            "spacing": 2,
                            "children": [
                              {
                                "type": "spacer"
                              },
                              {
                                "type": "image",
                                "source": {
                                  "kind": "sfSymbol",
                                  "name": "${row.arrow}"
                                },
                                "size": 9,
                                "tint": "${row.tone}"
                              },
                              {
                                "type": "text",
                                "text": "${row.change}",
                                "role": "caption",
                                "foreground": "${row.tone}",
                                "monospacedDigit": true,
                                "desktopRole": "detail"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "switch": "${and(settings.sparkline, gt(count(row.spark), 1))}",
                    "cases": {
                      "true": {
                        "type": "sparkline",
                        "values": "${row.spark}",
                        "height": 20,
                        "tint": "${row.tone}",
                        "desktopRole": "hide"
                      }
                    },
                    "default": {
                      "type": "none"
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "text",
            "text": "24h change · CoinGecko · ${date.clock(date.ms(transforms.first.last_updated))}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 1,
            "desktopRole": "hide"
          }
        ]
      },
      "none": {
        "type": "empty",
        "icon": "bitcoinsign.circle",
        "title": "No coins found",
        "subtitle": "Use CoinGecko ids such as bitcoin,ethereum,solana in widget settings."
      },
      "offline": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "wifi.slash",
            "title": "You’re offline",
            "subtitle": "Connect to the internet, then try again."
          },
          {
            "type": "text",
            "text": "${errors.data.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "timeout": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "hourglass",
            "title": "CoinGecko didn’t answer in time",
            "subtitle": "It may be busy. Try again in a moment."
          },
          {
            "type": "text",
            "text": "${errors.data.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "rateLimited": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "tortoise",
            "title": "CoinGecko is limiting requests",
            "subtitle": "The free service allows only so many. It refreshes again on its own."
          },
          {
            "type": "text",
            "text": "${errors.data.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      }
    },
    "default": {
      "type": "vstack",
      "spacing": 6,
      "children": [
        {
          "type": "empty",
          "icon": "exclamationmark.icloud",
          "title": "CoinGecko is unavailable",
          "subtitle": "Try again in a moment."
        },
        {
          "type": "text",
          "text": "${errors.data.message}",
          "role": "caption",
          "foreground": "tertiary",
          "lineLimit": 2,
          "desktopRole": "hide"
        },
        {
          "type": "hstack",
          "children": [
            {
              "type": "spacer"
            },
            {
              "type": "button",
              "title": "Try Again",
              "icon": "arrow.clockwise",
              "action": {
                "type": "refresh"
              }
            },
            {
              "type": "spacer"
            }
          ]
        }
      ]
    }
  },
  "status": {
    "prefix": "${coalesce(transforms.menu.ticker, '')}",
    "label": "${coalesce(transforms.menu.short, '')}",
    "tooltip": "${transforms.tip}"
  }
}
