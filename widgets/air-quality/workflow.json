{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Air quality from Open-Meteo (no key). Grades follow the Korean PM standard: PM2.5 0-15 / 16-35 / 36-75 / 76+, PM10 0-30 / 31-80 / 81-150 / 151+ µg/m³. The source is optional: offline, a timeout or a bad latitude/longitude (HTTP 400) gets its own state.",
  "sources": {
    "air": {
      "use": "http",
      "with": {
        "url": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${settings.lat}&longitude=${settings.lon}&current=pm10,pm2_5,us_aqi,european_aqi"
      },
      "optional": true
    }
  },
  "transforms": {
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "pm25": {
      "use": "assign",
      "from": "if(eq(number(sources.air.current.pm2_5), null), null, round(number(sources.air.current.pm2_5)))"
    },
    "pm10": {
      "use": "assign",
      "from": "if(eq(number(sources.air.current.pm10), null), null, round(number(sources.air.current.pm10)))"
    },
    "g25": {
      "use": "assign",
      "from": "if(eq(transforms.pm25, null), -1, if(lte(transforms.pm25, 15), 0, if(lte(transforms.pm25, 35), 1, if(lte(transforms.pm25, 75), 2, 3))))"
    },
    "g10": {
      "use": "assign",
      "from": "if(eq(transforms.pm10, null), -1, if(lte(transforms.pm10, 30), 0, if(lte(transforms.pm10, 80), 1, if(lte(transforms.pm10, 150), 2, 3))))"
    },
    "show": {
      "use": "template",
      "with": {
        "pm25": "${if(eq(transforms.pm25, null), '—', string(transforms.pm25))}",
        "pm10": "${if(eq(transforms.pm10, null), '—', string(transforms.pm10))}",
        "w25": "${if(transforms.ko, switch(transforms.g25, 0, '좋음', 1, '보통', 2, '나쁨', 3, '매우나쁨', '—'), switch(transforms.g25, 0, 'Good', 1, 'Moderate', 2, 'Unhealthy', 3, 'Very unhealthy', '—'))}",
        "w10": "${if(transforms.ko, switch(transforms.g10, 0, '좋음', 1, '보통', 2, '나쁨', 3, '매우나쁨', '—'), switch(transforms.g10, 0, 'Good', 1, 'Moderate', 2, 'Unhealthy', 3, 'Very unhealthy', '—'))}",
        "t25": "${switch(transforms.g25, 0, 'good', 1, 'accent', 2, 'warning', 3, 'danger', 'secondary')}",
        "t10": "${switch(transforms.g10, 0, 'good', 1, 'accent', 2, 'warning', 3, 'danger', 'secondary')}",
        "us": "${if(eq(sources.air.current.us_aqi, null), '—', string(round(number(sources.air.current.us_aqi))))}",
        "eu": "${if(eq(sources.air.current.european_aqi, null), '—', string(round(number(sources.air.current.european_aqi))))}",
        "at": "${date.clock(date.ms(concat(coalesce(sources.air.current.time, ''), ':00Z')))}",
        "icon": "${switch(transforms.g25, 0, 'aqi.low', 1, 'aqi.low', 2, 'aqi.medium', 3, 'aqi.high', 'aqi.low')}",
        "menuTint": "${switch(transforms.g25, 2, 'warning', 3, 'danger', '')}"
      }
    },
    "threshold": {
      "use": "assign",
      "from": "coalesce(number(settings.alertPM25), 36)"
    },
    "tip": {
      "use": "assign",
      "from": "if(eq(transforms.pm25, null), if(transforms.ko, concat(settings.place, ': 미세먼지 정보 없음'), concat(settings.place, ': no air quality data')), if(transforms.ko, concat(settings.place, ' 초미세먼지 ', transforms.show.pm25, ' µg/m³ (', transforms.show.w25, ') · 미세먼지 ', transforms.show.pm10, ' µg/m³ (', transforms.show.w10, ')'), concat(settings.place, ' PM2.5 ', transforms.show.pm25, ' µg/m³ (', transforms.show.w25, ') · PM10 ', transforms.show.pm10, ' µg/m³ (', transforms.show.w10, ')')))"
    }
  },
  "view": {
    "switch": "${if(eq(errors.air, null), 'ok', if(eq(errors.air.code, 400), 'badPlace', errors.air.kind))}",
    "cases": {
      "ok": {
        "action": {
          "type": "openApp",
          "value": "com.apple.weather"
        },
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "hstack",
            "spacing": 6,
            "children": [
              {
                "type": "image",
                "source": {
                  "kind": "sfSymbol",
                  "name": "${transforms.show.icon}"
                },
                "size": 14,
                "tint": "${transforms.show.t25}"
              },
              {
                "type": "text",
                "text": "${settings.place}",
                "role": "caption",
                "foreground": "secondary",
                "lineLimit": 1
              },
              {
                "type": "spacer"
              },
              {
                "type": "badge",
                "text": "${transforms.show.w25}",
                "tone": "${transforms.show.t25}"
              }
            ]
          },
          {
            "type": "hstack",
            "spacing": 12,
            "children": [
              {
                "type": "vstack",
                "spacing": 0,
                "desktopRole": "item",
                "children": [
                  {
                    "type": "text",
                    "text": "PM2.5",
                    "role": "caption",
                    "foreground": "secondary",
                    "desktopRole": "title"
                  },
                  {
                    "type": "text",
                    "text": "${transforms.show.pm25}",
                    "size": 36,
                    "role": "title",
                    "monospacedDigit": true,
                    "foreground": "${transforms.show.t25}",
                    "desktopRole": "value"
                  },
                  {
                    "type": "text",
                    "text": "µg/m³ · ${transforms.show.w25}",
                    "role": "caption",
                    "foreground": "secondary",
                    "lineLimit": 1,
                    "desktopRole": "detail"
                  }
                ]
              },
              {
                "type": "spacer"
              },
              {
                "type": "vstack",
                "spacing": 0,
                "desktopRole": "item",
                "children": [
                  {
                    "type": "text",
                    "text": "PM10",
                    "role": "caption",
                    "foreground": "secondary",
                    "desktopRole": "title"
                  },
                  {
                    "type": "text",
                    "text": "${transforms.show.pm10}",
                    "size": 24,
                    "role": "title",
                    "monospacedDigit": true,
                    "foreground": "${transforms.show.t10}",
                    "desktopRole": "value"
                  },
                  {
                    "type": "text",
                    "text": "µg/m³ · ${transforms.show.w10}",
                    "role": "caption",
                    "foreground": "secondary",
                    "lineLimit": 1,
                    "desktopRole": "detail"
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "text": "US AQI ${transforms.show.us} · EU AQI ${transforms.show.eu} · ${transforms.show.at}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 1,
            "desktopRole": "hide"
          }
        ]
      },
      "offline": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "wifi.slash",
            "title": "You’re offline",
            "subtitle": "Connect to the internet, then try again."
          },
          {
            "type": "text",
            "text": "${errors.air.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "timeout": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "hourglass",
            "title": "Open-Meteo didn’t answer in time",
            "subtitle": "It may be busy. Try again in a moment."
          },
          {
            "type": "text",
            "text": "${errors.air.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "rateLimited": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "tortoise",
            "title": "Open-Meteo is limiting requests",
            "subtitle": "The free service allows only so many. It refreshes again on its own."
          },
          {
            "type": "text",
            "text": "${errors.air.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      },
      "badPlace": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "empty",
            "icon": "mappin.slash",
            "title": "Check the location",
            "subtitle": "Latitude must be −90…90 and longitude −180…180. Fix them in this widget’s settings (⋯ ▸ Settings)."
          },
          {
            "type": "text",
            "text": "${errors.air.message}",
            "role": "caption",
            "foreground": "tertiary",
            "lineLimit": 2,
            "desktopRole": "hide"
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Try Again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "spacer"
              }
            ]
          }
        ]
      }
    },
    "default": {
      "type": "vstack",
      "spacing": 6,
      "children": [
        {
          "type": "empty",
          "icon": "exclamationmark.icloud",
          "title": "Open-Meteo is unavailable",
          "subtitle": "Try again in a moment."
        },
        {
          "type": "text",
          "text": "${errors.air.message}",
          "role": "caption",
          "foreground": "tertiary",
          "lineLimit": 2,
          "desktopRole": "hide"
        },
        {
          "type": "hstack",
          "children": [
            {
              "type": "spacer"
            },
            {
              "type": "button",
              "title": "Try Again",
              "icon": "arrow.clockwise",
              "action": {
                "type": "refresh"
              }
            },
            {
              "type": "spacer"
            }
          ]
        }
      ]
    }
  },
  "status": {
    "prefix": "PM2.5",
    "label": "${if(eq(transforms.pm25, null), '', string(transforms.pm25))}",
    "tint": "${transforms.show.menuTint}",
    "tooltip": "${transforms.tip}"
  },
  "alerts": {
    "bad": {
      "when": "${if(or(not(coalesce(settings.notify, true)), eq(transforms.pm25, null)), null, gte(transforms.pm25, transforms.threshold))}",
      "title": "${if(transforms.ko, concat(settings.place, ' 초미세먼지 ', transforms.show.pm25, ' µg/m³'), concat('PM2.5 ', transforms.show.pm25, ' µg/m³ in ', settings.place))}",
      "body": "${if(transforms.ko, concat('초미세먼지가 ', transforms.show.w25, ' 수준입니다. 외출할 때 마스크를 챙기세요.'), concat('Fine dust is ', transforms.show.w25, '. Consider a mask outdoors.'))}",
      "cooldownSec": 10800
    }
  }
}
