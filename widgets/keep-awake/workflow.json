{
  "schemaVersion": 1,
  "kind": "workflow",
  "sources": {
    "status": {
      "use": "fs.json",
      "with": {
        "path": "~/Library/Application Support/PowerDisplayGuard/status.json",
        "maxBytes": 262144
      }
    },
    "pending": {
      "use": "fs.json",
      "with": {
        "path": "~/Library/Application Support/PowerDisplayGuard/override.json",
        "maxBytes": 65536
      }
    }
  },
  "transforms": {
    "raw": {
      "use": "assign",
      "from": "sources.status.value"
    },
    "updatedMs": {
      "use": "assign",
      "from": "date.ms(transforms.raw.updatedAt)"
    },
    "age": {
      "use": "assign",
      "from": "if(eq(transforms.updatedMs, null), null, round(div(sub(now(), transforms.updatedMs), 1000)))"
    },
    "state": {
      "use": "assign",
      "from": "if(or(not(sources.status.exists), and(sources.status.valid, eq(transforms.raw, null))), 'missing', if(or(not(sources.status.valid), ne(transforms.raw.version, 1)), 'invalid', if(or(eq(transforms.age, null), gt(transforms.age, 45)), 'stale', 'ok')))"
    },
    "live": {
      "use": "assign",
      "from": "and(ne(transforms.state, 'missing'), ne(transforms.state, 'invalid'))"
    },
    "override": {
      "use": "assign",
      "from": "if(transforms.live, transforms.raw.override, null)"
    },
    "untilMs": {
      "use": "assign",
      "from": "if(transforms.override.until, coalesce(date.ms(transforms.override.until), 0), 0)"
    },
    "remaining": {
      "use": "assign",
      "from": "if(transforms.untilMs, duration.short(div(sub(transforms.untilMs, now()), 1000)), '')"
    },
    "graceText": {
      "use": "assign",
      "from": "if(and(transforms.live, eq(transforms.raw.phase, 'grace'), ne(number(transforms.raw.graceRemaining), null)), duration.short(transforms.raw.graceRemaining), '')"
    },
    "blockerList": {
      "use": "assign",
      "from": "if(transforms.live, transforms.raw.blockers, null)"
    },
    "guard": {
      "use": "template",
      "with": {
        "state": "${transforms.state}",
        "phase": "${if(transforms.live, coalesce(transforms.raw.phase, null), null)}",
        "onAC": "${if(transforms.live, if(transforms.raw.onAC, true, false), null)}",
        "holding": "${if(and(transforms.live, transforms.raw.holding), true, false)}",
        "sleepDisabled": "${if(and(transforms.live, transforms.raw.sleepDisabled), true, false)}",
        "ageSeconds": "${if(transforms.live, transforms.age, null)}",
        "remaining": "${transforms.remaining}",
        "untilText": "${if(transforms.untilMs, date.clock(transforms.untilMs), '')}",
        "untilMs": "${transforms.untilMs}",
        "fromMs": "${if(transforms.untilMs, coalesce(date.ms(coalesce(transforms.override.createdAt, transforms.raw.updatedAt)), now()), 0)}",
        "lidClosedEffective": "${if(and(transforms.untilMs, transforms.override.lidClosedEffective), true, false)}",
        "note": "${if(transforms.untilMs, default(transforms.override.note, ''), '')}",
        "graceText": "${transforms.graceText}",
        "requestPending": "${and(transforms.live, sources.pending.value.id, ne(coalesce(transforms.override.id, null), sources.pending.value.id))}",
        "blockers": {
          "forEach": "$.transforms.blockerList",
          "as": "b",
          "template": {
            "id": "${concat(string(b.pid), '-', b.type)}",
            "process": "${coalesce(b.process, concat('pid ', string(b.pid)))}",
            "type": "${default(b.type, '')}",
            "name": "${default(coalesce(b.assertionName, b.name), '')}"
          }
        },
        "blockerCount": "${count(transforms.blockerList)}",
        "icon": "${if(ne(transforms.state, 'ok'), 'exclamationmark.triangle', switch(transforms.raw.phase, 'override', 'cup.and.saucer.fill', 'grace', 'timer', 'ac', 'bolt.fill', 'moon.zzz'))}",
        "menuLabel": "${if(ne(transforms.state, 'ok'), '', switch(transforms.raw.phase, 'override', transforms.remaining, 'grace', transforms.graceText, ''))}",
        "problem": "${switch(transforms.state, 'missing', 'PowerDisplayGuard isn’t running', 'invalid', 'PowerDisplayGuard’s status couldn’t be read', 'stale', 'PowerDisplayGuard isn’t answering', '')}"
      }
    }
  },
  "view": {
    "type": "vstack",
    "spacing": 10,
    "children": [
      {
        "switch": "${transforms.guard.state}",
        "cases": {
          "missing": {
            "type": "vstack",
            "spacing": 6,
            "children": [
              {
                "type": "banner",
                "tone": "warning",
                "text": "PowerDisplayGuard isn’t running, so nothing here can keep the Mac awake.",
                "action": {
                  "type": "openURL",
                  "url": "https://github.com/jiunbae/settings"
                }
              },
              {
                "type": "button",
                "title": "About PowerDisplayGuard",
                "icon": "arrow.up.right.square",
                "action": {
                  "type": "openURL",
                  "url": "https://github.com/jiunbae/settings"
                }
              }
            ]
          },
          "stale": {
            "type": "banner",
            "tone": "warning",
            "text": "PowerDisplayGuard stopped answering ${transforms.guard.ageSeconds} s ago. What shows below may be out of date."
          },
          "invalid": {
            "type": "banner",
            "tone": "warning",
            "text": "PowerDisplayGuard’s status couldn’t be read."
          }
        },
        "default": {
          "type": "none"
        }
      },
      {
        "switch": "${transforms.guard.phase}",
        "cases": {
          "override": {
            "type": "vstack",
            "spacing": 6,
            "children": [
              {
                "type": "hstack",
                "spacing": 8,
                "children": [
                  {
                    "type": "image",
                    "source": {
                      "kind": "sfSymbol",
                      "name": "cup.and.saucer.fill"
                    },
                    "size": 18,
                    "tint": "accent"
                  },
                  {
                    "type": "text",
                    "role": "title",
                    "text": "Awake for ${transforms.guard.remaining}"
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "role": "caption",
                    "foreground": "secondary",
                    "text": "until ${transforms.guard.untilText}"
                  }
                ]
              },
              {
                "type": "progress",
                "style": "linear",
                "countdown": {
                  "from": "${transforms.guard.fromMs}",
                  "until": "${transforms.guard.untilMs}"
                },
                "tintRules": [
                  {
                    "whenRemainingLtSeconds": 600,
                    "tint": "warning"
                  }
                ]
              },
              {
                "switch": "${string(transforms.guard.lidClosedEffective)}",
                "cases": {
                  "true": {
                    "type": "text",
                    "role": "caption",
                    "foreground": "secondary",
                    "text": "Stays awake with the lid closed."
                  }
                },
                "default": {
                  "type": "text",
                  "role": "caption",
                  "foreground": "secondary",
                  "text": "Closing the lid still sleeps."
                }
              },
              {
                "switch": "${transforms.guard.note}",
                "cases": {
                  "": {
                    "type": "none"
                  }
                },
                "default": {
                  "type": "text",
                  "role": "caption",
                  "foreground": "warning",
                  "text": "${transforms.guard.note}"
                }
              }
            ]
          },
          "grace": {
            "type": "hstack",
            "spacing": 8,
            "children": [
              {
                "type": "image",
                "source": {
                  "kind": "sfSymbol",
                  "name": "timer"
                },
                "size": 18,
                "tint": "warning"
              },
              {
                "type": "text",
                "role": "title",
                "text": "On battery: sleep in ${transforms.guard.graceText}"
              }
            ]
          },
          "ac": {
            "type": "hstack",
            "spacing": 8,
            "children": [
              {
                "type": "image",
                "source": {
                  "kind": "sfSymbol",
                  "name": "bolt.fill"
                },
                "size": 18,
                "tint": "good"
              },
              {
                "type": "text",
                "role": "title",
                "text": "Awake on power"
              }
            ]
          },
          "battery": {
            "type": "hstack",
            "spacing": 8,
            "children": [
              {
                "type": "image",
                "source": {
                  "kind": "sfSymbol",
                  "name": "moon.zzz"
                },
                "size": 18,
                "tint": "secondary"
              },
              {
                "type": "text",
                "role": "title",
                "text": "On battery: sleep allowed"
              }
            ]
          }
        },
        "default": {
          "type": "none"
        }
      },
      {
        "switch": "${transforms.guard.requestPending}",
        "cases": {
          "true": {
            "type": "text",
            "role": "caption",
            "foreground": "secondary",
            "text": "Waiting for PowerDisplayGuard to pick up the request…"
          }
        },
        "default": {
          "type": "none"
        }
      },
      {
        "switch": "${if(or(eq(transforms.guard.state, 'ok'), eq(transforms.guard.state, 'stale')), 'live', 'off')}",
        "cases": {
          "live": {
            "type": "vstack",
            "spacing": 6,
            "children": [
              {
                "type": "hstack",
                "spacing": 6,
                "children": [
                  {
                    "type": "button",
                    "title": "1 h",
                    "action": {
                      "type": "run",
                      "thenRefresh": true,
                      "command": [
                        "/usr/bin/osascript",
                        "-l",
                        "JavaScript",
                        "./keep-awake.js",
                        "set",
                        "3600",
                        "${string(settings.lidClosed)}"
                      ]
                    }
                  },
                  {
                    "type": "button",
                    "title": "2 h",
                    "action": {
                      "type": "run",
                      "thenRefresh": true,
                      "command": [
                        "/usr/bin/osascript",
                        "-l",
                        "JavaScript",
                        "./keep-awake.js",
                        "set",
                        "7200",
                        "${string(settings.lidClosed)}"
                      ]
                    }
                  },
                  {
                    "type": "button",
                    "title": "4 h",
                    "action": {
                      "type": "run",
                      "thenRefresh": true,
                      "command": [
                        "/usr/bin/osascript",
                        "-l",
                        "JavaScript",
                        "./keep-awake.js",
                        "set",
                        "14400",
                        "${string(settings.lidClosed)}"
                      ]
                    }
                  },
                  {
                    "type": "button",
                    "title": "Until ${settings.untilTime}",
                    "action": {
                      "type": "run",
                      "thenRefresh": true,
                      "command": [
                        "/usr/bin/osascript",
                        "-l",
                        "JavaScript",
                        "./keep-awake.js",
                        "until",
                        "${settings.untilTime}",
                        "${string(settings.lidClosed)}"
                      ]
                    }
                  }
                ]
              },
              {
                "switch": "${string(settings.lidClosed)}",
                "cases": {
                  "true": {
                    "type": "text",
                    "role": "caption",
                    "foreground": "tertiary",
                    "text": "New requests keep it awake with the lid closed. Never longer than 12 hours."
                  }
                },
                "default": {
                  "type": "text",
                  "role": "caption",
                  "foreground": "tertiary",
                  "text": "New requests let it sleep when the lid closes. Never longer than 12 hours."
                }
              }
            ]
          }
        },
        "default": {
          "type": "none"
        }
      },
      {
        "type": "hstack",
        "spacing": 6,
        "children": [
          {
            "switch": "${transforms.guard.phase}",
            "cases": {
              "override": {
                "type": "button",
                "title": "Stop",
                "role": "destructive",
                "action": {
                  "type": "run",
                  "thenRefresh": true,
                  "command": [
                    "/usr/bin/osascript",
                    "-l",
                    "JavaScript",
                    "./keep-awake.js",
                    "cancel"
                  ]
                }
              }
            },
            "default": {
              "type": "none"
            }
          }
        ]
      },
      {
        "switch": "${transforms.guard.blockerCount}",
        "cases": {
          "0": {
            "type": "none"
          }
        },
        "default": {
          "type": "section",
          "title": "Also keeping it awake",
          "children": [
            {
              "type": "list",
              "spacing": 2,
              "items": {
                "forEach": "$.transforms.guard.blockers",
                "as": "b",
                "template": {
                  "type": "hstack",
                  "id": "blocker-${b.id}",
                  "spacing": 8,
                  "children": [
                    {
                      "type": "image",
                      "source": {
                        "kind": "sfSymbol",
                        "name": "app.badge"
                      },
                      "size": 12,
                      "tint": "secondary"
                    },
                    {
                      "type": "text",
                      "role": "body",
                      "lineLimit": 1,
                      "text": "${b.process}"
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "text",
                      "role": "caption",
                      "foreground": "secondary",
                      "lineLimit": 1,
                      "truncation": "middle",
                      "text": "${b.type}"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  },
  "status": {
    "label": "${transforms.guard.menuLabel}",
    "icon": "${transforms.guard.icon}",
    "tooltip": "${if(eq(transforms.guard.phase, 'override'), concat('Awake until ', transforms.guard.untilText), if(eq(transforms.guard.state, 'ok'), 'Keep Awake', 'PowerDisplayGuard isn’t answering'))}",
    "problem": "${transforms.guard.problem}"
  }
}
