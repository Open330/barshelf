{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.keep-awake",
  "name": "Keep Awake",
  "version": "0.3.2",
  "minHostVersion": "0.7.17",
  "icon": "cup.and.saucer",
  "bucket": {
    "group": "System",
    "order": 40,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 60,
    "staleAfterSec": 150,
    "triggers": [
      "wake"
    ]
  },
  "statusItem": {
    "mode": "dynamic",
    "icon": "cup.and.saucer",
    "popoverHero": false
  },
  "permissions": {
    "readPaths": [
      "~/Library/Application Support/PowerDisplayGuard"
    ],
    "exec": [
      {
        "command": "/usr/bin/osascript",
        "purpose": "Ask PowerDisplayGuard to keep the Mac awake for a while, or stop",
        "allowedArgs": [
          [
            "-l",
            "JavaScript",
            "./keep-awake.js",
            "set",
            "*",
            "*"
          ],
          [
            "-l",
            "JavaScript",
            "./keep-awake.js",
            "until",
            "*",
            "*"
          ],
          [
            "-l",
            "JavaScript",
            "./keep-awake.js",
            "cancel"
          ]
        ],
        "maxOutputBytes": 65536
      }
    ]
  },
  "settings": [
    {
      "key": "lidClosed",
      "title": "Stay awake with the lid closed",
      "type": "boolean",
      "default": false
    },
    {
      "key": "untilTime",
      "title": "“Until” time",
      "type": "enum",
      "default": "18:00",
      "options": [
        "12:00",
        "13:00",
        "14:00",
        "15:00",
        "16:00",
        "17:00",
        "18:00",
        "19:00",
        "20:00",
        "21:00",
        "22:00",
        "23:00"
      ],
      "optionTitles": [
        "12 PM (12:00)",
        "1 PM (13:00)",
        "2 PM (14:00)",
        "3 PM (15:00)",
        "4 PM (16:00)",
        "5 PM (17:00)",
        "6 PM (18:00)",
        "7 PM (19:00)",
        "8 PM (20:00)",
        "9 PM (21:00)",
        "10 PM (22:00)",
        "11 PM (23:00)"
      ]
    }
  ],
  "appearance": {
    "accent": "orange"
  },
  "localizations": {
    "ko": {
      "Ask PowerDisplayGuard to keep the Mac awake for a while, or stop": "PowerDisplayGuard로 Mac을 잠시 깨워 두거나 해제하기",
      "Keep Awake": "깨어 있기",
      "Stay awake with the lid closed": "덮개를 닫아도 깨어 있기",
      "PowerDisplayGuard isn’t running, so nothing here can keep the Mac awake.": "PowerDisplayGuard가 실행 중이 아니라서 여기서는 Mac을 깨워 둘 수 없습니다.",
      "PowerDisplayGuard stopped answering ${transforms.guard.ageSeconds} s ago. What shows below may be out of date.": "PowerDisplayGuard가 ${transforms.guard.ageSeconds}초 전부터 응답하지 않습니다. 아래 내용이 최신이 아닐 수 있습니다.",
      "PowerDisplayGuard’s status couldn’t be read.": "PowerDisplayGuard 상태를 읽을 수 없습니다.",
      "PowerDisplayGuard isn’t running": "PowerDisplayGuard가 실행 중이 아닙니다",
      "PowerDisplayGuard’s status couldn’t be read": "PowerDisplayGuard 상태를 읽을 수 없습니다",
      "PowerDisplayGuard isn’t answering": "PowerDisplayGuard가 응답하지 않습니다",
      "Awake for ${transforms.guard.remaining}": "${transforms.guard.remaining} 동안 깨어 있음",
      "until ${transforms.guard.untilText}": "${transforms.guard.untilText}까지",
      "On battery: sleep in ${transforms.guard.graceText}": "배터리: ${transforms.guard.graceText} 뒤 잠자기",
      "Awake on power": "전원 연결됨: 깨어 있음",
      "On battery: sleep allowed": "배터리: 잠자기 허용",
      "Waiting for PowerDisplayGuard to pick up the request…": "PowerDisplayGuard가 요청을 받기를 기다리는 중…",
      "1 h": "1시간",
      "2 h": "2시간",
      "4 h": "4시간",
      "Until ${settings.untilTime}": "${settings.untilTime}까지",
      "Stop": "중지",
      "Also keeping it awake": "함께 잠자기를 막는 프로세스",
      "Stays awake with the lid closed.": "덮개를 닫아도 깨어 있습니다.",
      "Closing the lid still sleeps.": "덮개를 닫으면 잠듭니다.",
      "New requests keep it awake with the lid closed. Never longer than 12 hours.": "새 요청은 덮개를 닫아도 깨어 있습니다. 최대 12시간입니다.",
      "New requests let it sleep when the lid closes. Never longer than 12 hours.": "새 요청은 덮개를 닫으면 잠듭니다. 최대 12시간입니다.",
      "“Until” time": "“~까지” 시각",
      "12 PM (12:00)": "오후 12시 (12:00)",
      "1 PM (13:00)": "오후 1시 (13:00)",
      "2 PM (14:00)": "오후 2시 (14:00)",
      "3 PM (15:00)": "오후 3시 (15:00)",
      "4 PM (16:00)": "오후 4시 (16:00)",
      "5 PM (17:00)": "오후 5시 (17:00)",
      "6 PM (18:00)": "오후 6시 (18:00)",
      "7 PM (19:00)": "오후 7시 (19:00)",
      "8 PM (20:00)": "오후 8시 (20:00)",
      "9 PM (21:00)": "오후 9시 (21:00)",
      "10 PM (22:00)": "오후 10시 (22:00)",
      "11 PM (23:00)": "오후 11시 (23:00)",
      "About PowerDisplayGuard": "PowerDisplayGuard 알아보기"
    }
  }
}
