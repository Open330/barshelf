{
  "schemaVersion": 1,
  "kind": "workflow",

  "sources": {
    "github": {
      "use": "http",
      "with": {
        "url": "https://www.githubstatus.com/api/v2/status.json"
      }
    }
  },

  "transforms": {
    "status": { "use": "assign", "from": "$.sources.github.status" },
    "page": { "use": "assign", "from": "$.sources.github.page" },
    "label": { "use": "assign", "from": "if(eq(transforms.status.indicator,'none'),'OK',if(eq(transforms.status.indicator,'minor'),'Minor',if(eq(transforms.status.indicator,'major'),'Major',if(eq(transforms.status.indicator,'critical'),'Critical',coalesce(transforms.status.indicator,'Unknown')))))" },
    "tone": { "use": "assign", "from": "if(eq(transforms.status.indicator,'none'),'good',if(eq(transforms.status.indicator,'minor'),'warning',if(or(eq(transforms.status.indicator,'major'),eq(transforms.status.indicator,'critical')),'danger','secondary')))" }
  },

  "view": {
    "action": {"type": "openURL", "url": "https://www.githubstatus.com"},
    "type": "vstack",
    "spacing": 8,
    "padding": 10,
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          { "type": "image", "source": { "kind": "sfSymbol", "name": "${if(eq(transforms.status.indicator,'none'),'checkmark.seal.fill','exclamationmark.triangle.fill')}" }, "size": 16, "tint": "${transforms.tone}" },
          { "type": "text", "text": "${transforms.page.name}", "role": "title", "lineLimit": 1 },
          { "type": "spacer" },
          { "type": "badge", "text": "${transforms.label}", "tint": "${transforms.tone}" }
        ]
      },
      {
        "type": "text",
        "text": "${transforms.status.description}",
        "role": "body",
        "lineLimit": 2
      },
      {
        "type": "text",
        "text": "Refreshes on open, every 15 minutes, and when your Mac wakes.",
        "role": "caption",
        "foreground": "secondary",
        "lineLimit": 2
      }
    ]
  },

  "status": {
    "label": "GitHub ${transforms.label}",
    "tooltip": "GitHub status: ${transforms.status.description}"
  }
}
