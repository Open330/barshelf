{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.github-status",
  "name": "GitHub Status",
  "version": "0.1.3",
  "icon": "checkmark.seal.fill",
  "bucket": { "group": "Developer", "order": 40, "size": "S" },

  "entry": { "kind": "workflow", "main": "workflow.json" },

  "refresh": {
    "onOpen": true,
    "interval": 900,
    "staleAfterSec": 900,
    "triggers": ["wake"]
  },

  "permissions": {
    "network": ["www.githubstatus.com"]
  },

  "appearance": {
    "accent": "green"
  },

  "localizations": {
    "ko": {
      "GitHub Status": "GitHub 상태",
      "Refreshes on open, every 15 minutes, and when your Mac wakes.": "열 때, 15분마다, Mac이 잠자기에서 깨어날 때 새로 고칩니다.",
      "GitHub status: ${transforms.status.description}": "GitHub 상태: ${transforms.status.description}"
    }
  }
}
