{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.github-status",
  "name": "GitHub Status",
  "version": "0.2.0",
  "icon": "checkmark.seal.fill",
  "bucket": {
    "group": "Developer",
    "order": 40,
    "size": "S"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 900,
    "staleAfterSec": 900,
    "runInBackground": true,
    "triggers": [
      "wake"
    ]
  },
  "permissions": {
    "network": [
      "www.githubstatus.com"
    ],
    "notifications": true
  },
  "appearance": {
    "accent": "green"
  },
  "localizations": {
    "ko": {
      "GitHub Status": "GitHub 상태",
      "Notify when GitHub has an incident": "GitHub 장애가 생기면 알림",
      "You’re offline": "오프라인 상태입니다",
      "Connect to the internet, then try again.": "인터넷에 연결한 뒤 다시 시도하세요.",
      "githubstatus.com didn’t answer in time": "githubstatus.com가 제때 응답하지 않았습니다",
      "It may be busy. Try again in a moment.": "혼잡할 수 있습니다. 잠시 후 다시 시도하세요.",
      "githubstatus.com is limiting requests": "githubstatus.com가 요청을 제한하고 있습니다",
      "The free service allows only so many. It refreshes again on its own.": "무료 서비스라 요청 수가 제한됩니다. 잠시 뒤 저절로 다시 새로 고칩니다.",
      "githubstatus.com is unavailable": "githubstatus.com에 연결할 수 없습니다",
      "Try again in a moment.": "잠시 후 다시 시도하세요.",
      "Try Again": "다시 시도"
    }
  },
  "minHostVersion": "0.7.32",
  "statusItem": {
    "mode": "dynamic",
    "icon": "checkmark.seal.fill"
  },
  "settings": [
    {
      "key": "notifyIncidents",
      "title": "Notify when GitHub has an incident",
      "type": "boolean",
      "default": false
    }
  ]
}
