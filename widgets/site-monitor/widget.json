{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.site-monitor",
  "name": "Site Monitor",
  "version": "0.2.1",
  "minHostVersion": "0.7.21",
  "icon": "antenna.radiowaves.left.and.right",
  "bucket": {
    "group": "Developer",
    "order": 50,
    "size": "S"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 60,
    "staleAfterSec": 120,
    "runInBackground": true,
    "triggers": [
      "wake"
    ]
  },
  "statusItem": {
    "mode": "dynamic",
    "icon": "antenna.radiowaves.left.and.right"
  },
  "permissions": {
    "exec": [
      {
        "command": "/bin/sh",
        "purpose": "Check whether a website answers, and how fast",
        "allowedArgs": [
          [
            "-c",
            "out=$(/usr/bin/curl -q -sS --globoff -o /dev/null --range 0-65535 --max-filesize 10485760 --proto =http,https --max-time \"$2\" -A BarShelf-SiteMonitor -w '{\"code\":\"%{http_code}\",\"time\":\"%{time_total}\",\"exit\":%{exitcode}}' --url \"$1\" 2>/dev/null); [ -n \"$out\" ] || out='{\"code\":\"0\",\"time\":null,\"exit\":-1}'; printf '%s' \"$out\"",
            "site-monitor",
            "*",
            "*"
          ]
        ],
        "maxOutputBytes": 4096,
        "sensitiveOutput": true
      }
    ],
    "storage": true,
    "notifications": true,
    "system": [
      "network"
    ]
  },
  "settings": [
    {
      "key": "url",
      "type": "string",
      "title": "URL to check",
      "default": "https://github.com"
    },
    {
      "key": "slowMs",
      "type": "integer",
      "title": "Slow above (ms)",
      "min": 100,
      "max": 30000,
      "default": 1000
    },
    {
      "key": "timeout",
      "type": "integer",
      "title": "Give up after (seconds)",
      "min": 2,
      "max": 30,
      "default": 10
    },
    {
      "key": "alertOnSlow",
      "type": "boolean",
      "title": "Notify when it gets slow",
      "default": false
    }
  ],
  "appearance": {
    "accent": "blue"
  },
  "localizations": {
    "ko": {
      "Check whether a website answers, and how fast": "웹사이트가 응답하는지와 응답 속도 확인",
      "Site Monitor": "사이트 모니터",
      "URL to check": "확인할 URL",
      "Slow above (ms)": "느림 기준 (ms)",
      "Give up after (seconds)": "제한 시간 (초)",
      "Enter an http:// or https:// address in the widget settings.": "위젯 설정에 http:// 또는 https:// 주소를 입력하세요.",
      "HTTP ${string(transforms.code)} · response time": "HTTP ${string(transforms.code)} · 응답 시간",
      "Down since ${date.clock(transforms.downSince)}": "${date.clock(transforms.downSince)}부터 응답 없음",
      "Notify when it gets slow": "느려지면 알림",
      "You’re offline": "오프라인 상태",
      "This Mac has no connection, so the site isn’t counted as down.": "이 Mac이 연결되어 있지 않아 사이트를 다운으로 보지 않습니다."
    }
  }
}
