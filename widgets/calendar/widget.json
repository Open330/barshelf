{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.calendar",
  "name": "Calendar",
  "version": "0.2.0",
  "icon": "calendar",
  "bucket": {
    "group": "Everyday",
    "order": 13,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 3600,
    "staleAfterSec": 3600,
    "triggers": [
      "wake"
    ]
  },
  "appearance": {
    "accent": "red"
  },
  "localizations": {
    "ko": {
      "Calendar": "달력",
      "Su": "일",
      "Mo": "월",
      "Tu": "화",
      "We": "수",
      "Th": "목",
      "Fr": "금",
      "Sa": "토"
    }
  },
  "statusItem": {
    "mode": "icon",
    "icon": "calendar"
  },
  "minHostVersion": "0.7.17"
}
