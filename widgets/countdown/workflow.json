{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "D-day countdown. /bin/date gives today's local date as a UTC-midnight ISO string, so the day difference to the target (also read as UTC midnight) is a whole number with no time-zone drift.",
  "sources": {
    "clock": {
      "use": "exec",
      "with": {
        "command": [
          "/bin/date",
          "+{\"today\":\"%Y-%m-%dT00:00:00Z\"}"
        ]
      }
    }
  },
  "transforms": {
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "today": {
      "use": "assign",
      "from": "date.ms(sources.clock.today)"
    },
    "d1": {
      "use": "assign",
      "from": "if(or(eq(transforms.today, null), eq(date.ms(concat(coalesce(settings.date1, ''), 'T00:00:00Z')), null)), null, round(div(sub(date.ms(concat(coalesce(settings.date1, ''), 'T00:00:00Z')), transforms.today), 86400000)))"
    },
    "e1": {
      "use": "template",
      "with": {
        "ok": "${ne(transforms.d1, null)}",
        "title": "${coalesce(settings.title1, if(transforms.ko, '이벤트', 'Event'))}",
        "date": "${coalesce(settings.date1, '')}",
        "dlabel": "${if(eq(transforms.d1, null), '—', if(gt(transforms.d1, 0), concat('D-', string(transforms.d1)), if(eq(transforms.d1, 0), 'D-day', concat('D+', string(mul(transforms.d1, -1))))))}",
        "left": "${if(eq(transforms.d1, null), if(transforms.ko, '날짜를 YYYY-MM-DD로 입력하세요', 'Enter the date as YYYY-MM-DD'), if(eq(transforms.d1, 0), if(transforms.ko, '오늘', 'Today'), if(gt(transforms.d1, 0), if(transforms.ko, concat(string(transforms.d1), '일 남음'), concat(string(transforms.d1), if(eq(transforms.d1, 1), ' day left', ' days left'))), if(transforms.ko, concat(string(mul(transforms.d1, -1)), '일 지남'), concat(string(mul(transforms.d1, -1)), if(eq(transforms.d1, -1), ' day ago', ' days ago'))))))}",
        "tone": "${if(eq(transforms.d1, null), 'secondary', if(eq(transforms.d1, 0), 'good', if(lt(transforms.d1, 0), 'secondary', if(lte(transforms.d1, 7), 'warning', 'accent'))))}"
      }
    },
    "d2": {
      "use": "assign",
      "from": "if(or(eq(transforms.today, null), eq(date.ms(concat(coalesce(settings.date2, ''), 'T00:00:00Z')), null)), null, round(div(sub(date.ms(concat(coalesce(settings.date2, ''), 'T00:00:00Z')), transforms.today), 86400000)))"
    },
    "e2": {
      "use": "template",
      "with": {
        "ok": "${ne(transforms.d2, null)}",
        "title": "${coalesce(settings.title2, if(transforms.ko, '이벤트', 'Event'))}",
        "date": "${coalesce(settings.date2, '')}",
        "dlabel": "${if(eq(transforms.d2, null), '—', if(gt(transforms.d2, 0), concat('D-', string(transforms.d2)), if(eq(transforms.d2, 0), 'D-day', concat('D+', string(mul(transforms.d2, -1))))))}",
        "left": "${if(eq(transforms.d2, null), if(transforms.ko, '날짜를 YYYY-MM-DD로 입력하세요', 'Enter the date as YYYY-MM-DD'), if(eq(transforms.d2, 0), if(transforms.ko, '오늘', 'Today'), if(gt(transforms.d2, 0), if(transforms.ko, concat(string(transforms.d2), '일 남음'), concat(string(transforms.d2), if(eq(transforms.d2, 1), ' day left', ' days left'))), if(transforms.ko, concat(string(mul(transforms.d2, -1)), '일 지남'), concat(string(mul(transforms.d2, -1)), if(eq(transforms.d2, -1), ' day ago', ' days ago'))))))}",
        "tone": "${if(eq(transforms.d2, null), 'secondary', if(eq(transforms.d2, 0), 'good', if(lt(transforms.d2, 0), 'secondary', if(lte(transforms.d2, 7), 'warning', 'accent'))))}"
      }
    }
  },
  "view": {
    "type": "vstack",
    "spacing": 6,
    "children": [
      {
        "type": "vstack",
        "spacing": 1,
        "desktopRole": "item",
        "children": [
          {
            "type": "text",
            "text": "${transforms.e1.title}",
            "role": "caption",
            "foreground": "secondary",
            "lineLimit": 1,
            "desktopRole": "title"
          },
          {
            "type": "text",
            "text": "${transforms.e1.dlabel}",
            "size": 40,
            "role": "title",
            "monospacedDigit": true,
            "foreground": "${transforms.e1.tone}",
            "desktopRole": "value"
          },
          {
            "type": "text",
            "text": "${transforms.e1.date} · ${transforms.e1.left}",
            "role": "caption",
            "foreground": "secondary",
            "lineLimit": 1,
            "desktopRole": "detail"
          }
        ]
      },
      {
        "switch": "${or(ne(coalesce(settings.title2), null), ne(coalesce(settings.date2), null))}",
        "cases": {
          "true": {
            "type": "vstack",
            "spacing": 6,
            "children": [
              {
                "type": "divider"
              },
              {
                "type": "hstack",
                "id": "event-2",
                "spacing": 8,
                "desktopRole": "item",
                "children": [
                  {
                    "type": "vstack",
                    "spacing": 1,
                    "widthFill": true,
                    "children": [
                      {
                        "type": "text",
                        "text": "${transforms.e2.title}",
                        "role": "body",
                        "lineLimit": 1,
                        "desktopRole": "title"
                      },
                      {
                        "type": "text",
                        "text": "${transforms.e2.date} · ${transforms.e2.left}",
                        "role": "caption",
                        "foreground": "secondary",
                        "lineLimit": 1,
                        "desktopRole": "detail"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "${transforms.e2.dlabel}",
                    "size": 20,
                    "role": "title",
                    "monospacedDigit": true,
                    "foreground": "${transforms.e2.tone}",
                    "desktopRole": "value"
                  }
                ]
              }
            ]
          }
        },
        "default": {
          "type": "none"
        }
      }
    ]
  },
  "status": {
    "label": "${if(transforms.e1.ok, transforms.e1.dlabel, '')}",
    "tooltip": "${transforms.e1.title}: ${transforms.e1.left}"
  },
  "alerts": {
    "today1": {
      "when": "${if(eq(transforms.d1, null), null, eq(transforms.d1, 0))}",
      "title": "${if(transforms.ko, concat('디데이: ', transforms.e1.title), concat('D-day: ', transforms.e1.title))}",
      "body": "${transforms.e1.date}",
      "cooldownSec": 43200
    },
    "today2": {
      "when": "${if(eq(transforms.d2, null), null, eq(transforms.d2, 0))}",
      "title": "${if(transforms.ko, concat('디데이: ', transforms.e2.title), concat('D-day: ', transforms.e2.title))}",
      "body": "${transforms.e2.date}",
      "cooldownSec": 43200
    }
  }
}