{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.countdown",
  "name": "Countdown",
  "version": "0.2.0",
  "minHostVersion": "0.7.21",
  "icon": "calendar.badge.clock",
  "bucket": {
    "group": "Everyday",
    "order": 42,
    "size": "S"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 300,
    "staleAfterSec": 300,
    "runInBackground": true,
    "triggers": [
      "wake"
    ]
  },
  "statusItem": {
    "mode": "text",
    "icon": "calendar.badge.clock"
  },
  "permissions": {
    "exec": [
      {
        "command": "/bin/date",
        "allowedArgs": [
          [
            "+{\"today\":\"%Y-%m-%dT00:00:00Z\"}"
          ]
        ],
        "maxOutputBytes": 1024,
        "sensitiveOutput": false
      }
    ],
    "notifications": true
  },
  "settings": [
    {
      "key": "title1",
      "title": "Event",
      "type": "string",
      "default": ""
    },
    {
      "key": "date1",
      "title": "Date (YYYY-MM-DD)",
      "type": "string",
      "default": ""
    },
    {
      "key": "title2",
      "title": "Second event (optional)",
      "type": "string",
      "default": ""
    },
    {
      "key": "date2",
      "title": "Second date (YYYY-MM-DD)",
      "type": "string",
      "default": ""
    },
    {
      "key": "remindDays",
      "title": "Remind me this many days before (0 = off)",
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 90
    }
  ],
  "appearance": {
    "accent": "pink"
  },
  "localizations": {
    "ko": {
      "Countdown": "디데이",
      "Event": "이벤트",
      "Date (YYYY-MM-DD)": "날짜 (YYYY-MM-DD)",
      "Second event (optional)": "두 번째 이벤트 (선택)",
      "Second date (YYYY-MM-DD)": "두 번째 날짜 (YYYY-MM-DD)",
      "Remind me this many days before (0 = off)": "며칠 전에 알릴지 (0 = 끄기)",
      "No event yet": "아직 이벤트 없음",
      "Add an event name and a date (YYYY-MM-DD) in this widget’s settings (⋯ ▸ Settings).": "이 위젯 설정(⋯ ▸ 설정)에서 이벤트 이름과 날짜(YYYY-MM-DD)를 입력하세요."
    }
  }
}
