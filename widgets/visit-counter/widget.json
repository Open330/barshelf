{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.visit-counter",
  "name": "Visit Counter",
  "version": "0.1.2",
  "icon": "sparkles",
  "bucket": { "group": "Demo", "order": 45, "size": "S" },

  "entry": { "kind": "workflow", "main": "workflow.json" },

  "refresh": { "onOpen": true, "interval": null, "staleAfterSec": 1 },

  "permissions": {
    "storage": true
  },

  "appearance": {
    "accent": "purple"
  },

  "localizations": {
    "ko": {
      "Visit Counter": "방문 횟수",
      "visits": "번 방문",
      "First seen ${date.relative(coalesce(storage.firstAt, now()))}": "처음 방문 ${date.relative(coalesce(storage.firstAt, now()))}",
      "Previous visit ${date.relative(coalesce(storage.lastAt, now()))}": "이전 방문 ${date.relative(coalesce(storage.lastAt, now()))}",
      "Visits: ${string(add(coalesce(storage.count, 0), 1))}": "방문 횟수: ${string(add(coalesce(storage.count, 0), 1))}"
    }
  }
}
