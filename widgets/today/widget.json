{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.today",
  "name": "Today",
  "version": "0.2.0",
  "icon": "calendar",
  "bucket": {
    "group": "Everyday",
    "order": 10,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 60,
    "staleAfterSec": 60,
    "triggers": [
      "wake"
    ]
  },
  "appearance": {
    "accent": "red"
  },
  "localizations": {
    "ko": {
      "Today": "오늘"
    }
  },
  "statusItem": {
    "mode": "text",
    "icon": "calendar"
  },
  "minHostVersion": "0.7.17"
}
