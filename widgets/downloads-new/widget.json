{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.downloads-new",
  "name": "Downloads",
  "version": "0.1.3",
  "icon": "arrow.down.circle.fill",
  "bucket": { "group": "Files", "order": 35, "size": "S" },

  "entry": { "kind": "workflow", "main": "workflow.json" },

  "refresh": { "onOpen": true, "interval": null, "staleAfterSec": 5 },

  "permissions": {
    "readPaths": ["~/Downloads"],
    "storage": true
  },

  "settings": [
    { "key": "folder", "title": "Folder", "type": "directory", "default": "~/Downloads" }
  ],

  "appearance": {
    "accent": "green"
  },

  "localizations": {
    "ko": {
      "Downloads": "다운로드",
      "Folder": "폴더",
      "${count(transforms.items)} files": "파일 ${count(transforms.items)}개",
      "${count(transforms.items)} files in ${file.basename(settings.folder)}": "${file.basename(settings.folder)}의 파일 ${count(transforms.items)}개",
      "${if(gte(sub(count(transforms.items), coalesce(storage.count, count(transforms.items))), 0), '+', '')}${string(sub(count(transforms.items), coalesce(storage.count, count(transforms.items))))} since last check": "지난 확인 이후 ${if(gte(sub(count(transforms.items), coalesce(storage.count, count(transforms.items))), 0), '+', '')}${string(sub(count(transforms.items), coalesce(storage.count, count(transforms.items))))}"
    }
  }
}
