{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.downloads-new",
  "name": "Downloads",
  "version": "0.2.1",
  "icon": "arrow.down.circle.fill",
  "bucket": {
    "group": "Files",
    "order": 35,
    "size": "S"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": null,
    "staleAfterSec": 300
  },
  "permissions": {
    "readPaths": [
      "~/Downloads"
    ],
    "storage": true
  },
  "settings": [
    {
      "key": "folder",
      "title": "Folder",
      "type": "directory",
      "default": "~/Downloads"
    }
  ],
  "appearance": {
    "accent": "green"
  },
  "localizations": {
    "ko": {
      "Downloads": "다운로드",
      "Folder": "폴더",
      "Folder not found": "폴더를 찾을 수 없음",
      "${file.basename(settings.folder)} was moved or deleted. Pick another folder in the widget settings.": "${file.basename(settings.folder)} 폴더가 옮겨졌거나 삭제되었습니다. 위젯 설정에서 다른 폴더를 고르세요.",
      "Nothing here yet": "아직 아무것도 없음",
      "New downloads show up here as they arrive.": "새로 받은 파일이 도착하는 대로 여기에 나타납니다.",
      "Mark as Seen": "확인함으로 표시",
      "New": "새 파일",
      "Show in Finder": "Finder에서 보기"
    }
  },
  "minHostVersion": "0.7.32",
  "statusItem": {
    "mode": "dynamic",
    "icon": "arrow.down.circle.fill"
  }
}
