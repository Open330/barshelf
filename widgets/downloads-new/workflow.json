{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "What arrived in a folder (Downloads by default) since you last looked. 'Last looked' is a timestamp kept in storage.checkedAt that moves only when you ask: the Mark as Seen button (a refresh action) or the card's Refresh, both of which set widget.requested (BarShelf 0.7.22). Opening the popup, the folder watch and settings changes leave it alone, so a file stays new until you have seen it. The first reading sets the baseline. A file counts as new when its modification time is after that timestamp; the newest five are listed with thumbnails. The listing reads at most 500 entries (shown as 500+). The source watches the folder, so the card follows new files without polling, and is optional (BarShelf 0.7.32): a folder that was moved or deleted says so.",
  "sources": {
    "files": {
      "use": "fs.directory",
      "optional": true,
      "with": {
        "path": "${settings.folder}",
        "watch": true,
        "skipHidden": true,
        "sortBy": "modifiedAt",
        "sortDirection": "descending",
        "limit": 500
      }
    }
  },
  "transforms": {
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "items": {
      "use": "assign",
      "from": "$.sources.files.items"
    },
    "missing": {
      "use": "assign",
      "from": "ne(errors.files, null)"
    },
    "n": {
      "use": "assign",
      "from": "count(transforms.items)"
    },
    "countText": {
      "use": "assign",
      "from": "if(gte(transforms.n, 500), '500+', string(transforms.n))"
    },
    "checkedAt": {
      "use": "assign",
      "from": "coalesce(storage.checkedAt, now())"
    },
    "rows": {
      "use": "template",
      "with": {
        "forEach": "$.transforms.items",
        "as": "f",
        "template": {
          "id": "dl-${f.path}",
          "path": "${f.path}",
          "name": "${f.name}",
          "modifiedAt": "${f.modifiedAt}",
          "isNew": "${gt(f.modifiedAt, transforms.checkedAt)}",
          "age": "${if(lt(sub(now(), f.modifiedAt), 60000), if(transforms.ko, '방금', 'just now'), if(lt(sub(now(), f.modifiedAt), 3600000), concat(string(round(div(sub(now(), f.modifiedAt), 60000))), if(transforms.ko, '분 전', 'm ago')), if(lt(sub(now(), f.modifiedAt), 86400000), concat(string(round(div(sub(now(), f.modifiedAt), 3600000))), if(transforms.ko, '시간 전', 'h ago')), concat(string(round(div(sub(now(), f.modifiedAt), 86400000))), if(transforms.ko, '일 전', 'd ago')))))}"
        }
      }
    },
    "fresh": {
      "use": "filter",
      "from": "$.transforms.rows",
      "with": {
        "field": "isNew",
        "equals": true
      }
    },
    "newCount": {
      "use": "assign",
      "from": "count(transforms.fresh)"
    },
    "recent": {
      "use": "limit",
      "from": "$.transforms.rows",
      "with": {
        "count": 5
      }
    },
    "sinceText": {
      "use": "assign",
      "from": "if(lt(sub(now(), transforms.checkedAt), 86400000), date.clock(transforms.checkedAt), concat(string(round(div(sub(now(), transforms.checkedAt), 86400000))), if(transforms.ko, '일 전', 'd ago')))"
    },
    "headline": {
      "use": "assign",
      "from": "if(transforms.ko, if(eq(transforms.newCount, 0), concat(transforms.sinceText, ' 이후 새 파일 없음'), concat(transforms.sinceText, ' 이후 새 파일 ', string(transforms.newCount), '개')), if(eq(transforms.newCount, 0), concat('Nothing new since ', transforms.sinceText), concat(string(transforms.newCount), if(eq(transforms.newCount, 1), ' new file', ' new files'), ' since ', transforms.sinceText)))"
    }
  },
  "view": {
    "type": "vstack",
    "spacing": 8,
    "children": [
      {
        "type": "hstack",
        "spacing": 7,
        "action": {
          "type": "revealFile",
          "path": "${settings.folder}"
        },
        "children": [
          {
            "type": "image",
            "source": {
              "kind": "sfSymbol",
              "name": "arrow.down.circle.fill"
            },
            "size": 14,
            "tint": "accent"
          },
          {
            "type": "text",
            "text": "${file.basename(settings.folder)}",
            "role": "body",
            "lineLimit": 1
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "${if(transforms.missing, '', concat(transforms.countText, if(transforms.ko, '개', ' files')))}",
            "role": "caption",
            "foreground": "secondary",
            "monospacedDigit": true
          }
        ]
      },
      {
        "switch": "${if(transforms.missing, 'missing', if(eq(transforms.n, 0), 'empty', 'files'))}",
        "cases": {
          "missing": {
            "type": "empty",
            "icon": "questionmark.folder",
            "title": "Folder not found",
            "subtitle": "${file.basename(settings.folder)} was moved or deleted. Pick another folder in the widget settings."
          },
          "empty": {
            "type": "empty",
            "icon": "tray",
            "title": "Nothing here yet",
            "subtitle": "New downloads show up here as they arrive."
          },
          "files": {
            "type": "vstack",
            "spacing": 6,
            "children": [
              {
                "type": "hstack",
                "spacing": 6,
                "children": [
                  {
                    "type": "text",
                    "text": "${transforms.headline}",
                    "role": "body",
                    "monospacedDigit": true,
                    "lineLimit": 2,
                    "widthFill": true,
                    "foreground": "${if(gt(transforms.newCount, 0), 'good', 'secondary')}"
                  },
                  {
                    "type": "button",
                    "title": "Mark as Seen",
                    "icon": "checkmark",
                    "hidden": "${eq(transforms.newCount, 0)}",
                    "action": {
                      "type": "refresh"
                    }
                  }
                ]
              },
              {
                "type": "list",
                "spacing": 2,
                "items": {
                  "forEach": "$.transforms.recent",
                  "as": "file",
                  "template": {
                    "type": "hstack",
                    "id": "${file.id}",
                    "spacing": 8,
                    "padding": 4,
                    "drag": {
                      "filePath": "${file.path}"
                    },
                    "action": {
                      "type": "openFile",
                      "path": "${file.path}"
                    },
                    "children": [
                      {
                        "type": "image",
                        "source": {
                          "kind": "fileThumbnail",
                          "path": "${file.path}",
                          "modifiedAt": "${file.modifiedAt}"
                        },
                        "size": 28
                      },
                      {
                        "type": "vstack",
                        "spacing": 1,
                        "widthFill": true,
                        "children": [
                          {
                            "type": "text",
                            "text": "${file.name}",
                            "role": "body",
                            "lineLimit": 1,
                            "truncation": "middle"
                          },
                          {
                            "type": "text",
                            "text": "${file.age}",
                            "role": "caption",
                            "foreground": "tertiary",
                            "lineLimit": 1
                          }
                        ]
                      },
                      {
                        "type": "badge",
                        "text": "New",
                        "tone": "good",
                        "hidden": "${not(file.isNew)}"
                      },
                      {
                        "type": "button",
                        "icon": "magnifyingglass",
                        "accessibilityLabel": "Show in Finder",
                        "action": {
                          "type": "revealFile",
                          "path": "${file.path}"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    ]
  },
  "store": {
    "checkedAt": {
      "value": "${if(transforms.missing, storage.checkedAt, if(or(widget.requested, eq(storage.checkedAt, null)), now(), storage.checkedAt))}"
    }
  },
  "status": {
    "label": "${if(transforms.missing, '—', string(transforms.newCount))}",
    "tooltip": "${if(transforms.missing, concat(file.basename(settings.folder), if(transforms.ko, ': 폴더 없음', ': not found')), transforms.headline)}"
  }
}
