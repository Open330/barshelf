{
  "$schema": "https://barshelf.jiun.dev/schema/workflow-0.1.json",
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Hardware sensors from the native `system` source: SMC temperatures and fans, with the Apple Silicon HID sensor plane as the fallback. Every reading is optional, so the view switches on sensors.available. Displayed temperatures are converted per `settings.unit`; the progress thresholds stay in Celsius because that is what they were calibrated against. With the card closed the source is told what the menu bar shows: every SMC key is its own IOKit round trip, so reading one component instead of all of them - and skipping `detail`, which is only the card's sensor list - takes a refresh from ~27 ms to ~4 ms. Opening the card sets widget.visible and the host re-runs the workflow at full breadth. The coalesce defaults keep the widget correct on a host that predates widget.visible: there it simply samples everything, as it always did. The menu bar reading can be any single sensor: the settings picker lists this Mac's sensors as `key:<KEY>`, and the same value in `sensors` asks the source for that key alone, returned as `sensors.picked` (the first) and `sensors.pickedList`. A second reading (`menuBarSecondary`) becomes a second metric; `aggregate: hottest` shows a component's hottest sensor (`cpuMax` etc.) instead of its average.",
  "sources": {
    "data": {
      "use": "system",
      "with": {
        "metrics": [
          "sensors"
        ],
        "detail": "${coalesce(widget.visible, true)}",
        "sensors": [
          "${if(coalesce(widget.visible, true), 'all', coalesce(settings.menuBarSensor, 'cpu'))}",
          "${coalesce(settings.menuBarSensor, 'cpu')}",
          "${coalesce(settings.menuBarSecondary, 'none')}"
        ]
      }
    }
  },
  "transforms": {
    "fahrenheit": {
      "use": "assign",
      "from": "eq(settings.unit,'fahrenheit')"
    },
    "sel1": {
      "use": "assign",
      "from": "coalesce(settings.menuBarSensor, 'cpu')"
    },
    "isKey1": {
      "use": "assign",
      "from": "contains(transforms.sel1, 'key:')"
    },
    "picked1": {
      "use": "assign",
      "from": "if(transforms.isKey1, sources.data.sensors.picked, null)"
    },
    "kind1": {
      "use": "assign",
      "from": "if(transforms.isKey1, coalesce(transforms.picked1.kind, 'temperature'), switch(transforms.sel1, 'power', 'power', 'fan', 'fan', 'fanUsage', 'fanUsage', 'none', 'none', 'temperature'))"
    },
    "isTemp1": {
      "use": "assign",
      "from": "eq(transforms.kind1, 'temperature')"
    },
    "raw1": {
      "use": "assign",
      "from": "if(transforms.isKey1, transforms.picked1.value, switch(transforms.sel1, 'power', sources.data.sensors.power, 'fan', sources.data.sensors.fans.0.rpm, 'fanUsage', sources.data.sensors.fans.0.usage, 'gpu', if(eq(settings.aggregate,'hottest'), coalesce(sources.data.sensors.gpuMax, sources.data.sensors.gpu), sources.data.sensors.gpu), 'battery', if(eq(settings.aggregate,'hottest'), coalesce(sources.data.sensors.batteryMax, sources.data.sensors.battery), sources.data.sensors.battery), 'peak', sources.data.sensors.peak, 'none', null, if(eq(settings.aggregate,'hottest'), coalesce(sources.data.sensors.cpuMax, sources.data.sensors.cpu), sources.data.sensors.cpu)))"
    },
    "shown1": {
      "use": "assign",
      "from": "if(eq(transforms.raw1, null), null, if(and(transforms.isTemp1, transforms.fahrenheit), add(mul(number(transforms.raw1), 1.8), 32), number(transforms.raw1)))"
    },
    "unit1": {
      "use": "assign",
      "from": "switch(transforms.kind1, 'power', 'W', 'fan', 'rpm', 'fanUsage', '%', if(transforms.fahrenheit, '°F', '°C'))"
    },
    "label1": {
      "use": "assign",
      "from": "if(transforms.isKey1, coalesce(transforms.picked1.name, 'Sensor'), switch(transforms.sel1, 'power', 'Power', 'fan', 'Fan speed', 'fanUsage', 'Fan load', 'gpu', if(eq(settings.aggregate,'hottest'), 'Hottest GPU', 'GPU temperature'), 'battery', if(eq(settings.aggregate,'hottest'), 'Hottest battery', 'Battery temperature'), 'peak', 'Hottest sensor', 'none', '', if(eq(settings.aggregate,'hottest'), 'Hottest CPU', 'CPU temperature')))"
    },
    "prefix1": {
      "use": "assign",
      "from": "if(transforms.isKey1, switch(transforms.kind1, 'power', 'Power', 'fan', 'Fan', coalesce(transforms.picked1.key, 'Sensor')), switch(transforms.sel1, 'power', 'Power', 'fan', 'Fan', 'fanUsage', 'Fan', 'gpu', 'GPU', 'battery', 'Batt', 'peak', 'Peak', 'none', '', 'CPU'))"
    },
    "sel2": {
      "use": "assign",
      "from": "coalesce(settings.menuBarSecondary, 'none')"
    },
    "isKey2": {
      "use": "assign",
      "from": "contains(transforms.sel2, 'key:')"
    },
    "picked2": {
      "use": "assign",
      "from": "if(transforms.isKey2, if(and(transforms.isKey1, ne(transforms.sel1, transforms.sel2)), sources.data.sensors.pickedList.1, sources.data.sensors.pickedList.0), null)"
    },
    "kind2": {
      "use": "assign",
      "from": "if(transforms.isKey2, coalesce(transforms.picked2.kind, 'temperature'), switch(transforms.sel2, 'power', 'power', 'fan', 'fan', 'fanUsage', 'fanUsage', 'none', 'none', 'temperature'))"
    },
    "isTemp2": {
      "use": "assign",
      "from": "eq(transforms.kind2, 'temperature')"
    },
    "raw2": {
      "use": "assign",
      "from": "if(transforms.isKey2, transforms.picked2.value, switch(transforms.sel2, 'power', sources.data.sensors.power, 'fan', sources.data.sensors.fans.0.rpm, 'fanUsage', sources.data.sensors.fans.0.usage, 'gpu', if(eq(settings.aggregate,'hottest'), coalesce(sources.data.sensors.gpuMax, sources.data.sensors.gpu), sources.data.sensors.gpu), 'battery', if(eq(settings.aggregate,'hottest'), coalesce(sources.data.sensors.batteryMax, sources.data.sensors.battery), sources.data.sensors.battery), 'peak', sources.data.sensors.peak, 'none', null, if(eq(settings.aggregate,'hottest'), coalesce(sources.data.sensors.cpuMax, sources.data.sensors.cpu), sources.data.sensors.cpu)))"
    },
    "shown2": {
      "use": "assign",
      "from": "if(eq(transforms.raw2, null), null, if(and(transforms.isTemp2, transforms.fahrenheit), add(mul(number(transforms.raw2), 1.8), 32), number(transforms.raw2)))"
    },
    "unit2": {
      "use": "assign",
      "from": "switch(transforms.kind2, 'power', 'W', 'fan', 'rpm', 'fanUsage', '%', if(transforms.fahrenheit, '°F', '°C'))"
    },
    "label2": {
      "use": "assign",
      "from": "if(transforms.isKey2, coalesce(transforms.picked2.name, 'Sensor'), switch(transforms.sel2, 'power', 'Power', 'fan', 'Fan speed', 'fanUsage', 'Fan load', 'gpu', if(eq(settings.aggregate,'hottest'), 'Hottest GPU', 'GPU temperature'), 'battery', if(eq(settings.aggregate,'hottest'), 'Hottest battery', 'Battery temperature'), 'peak', 'Hottest sensor', 'none', '', if(eq(settings.aggregate,'hottest'), 'Hottest CPU', 'CPU temperature')))"
    },
    "prefix2": {
      "use": "assign",
      "from": "if(transforms.isKey2, switch(transforms.kind2, 'power', 'Power', 'fan', 'Fan', coalesce(transforms.picked2.key, 'Sensor')), switch(transforms.sel2, 'power', 'Power', 'fan', 'Fan', 'fanUsage', 'Fan', 'gpu', 'GPU', 'battery', 'Batt', 'peak', 'Peak', 'none', '', 'CPU'))"
    },
    "decimals": {
      "use": "assign",
      "from": "0"
    },
    "hottest": {
      "use": "sort",
      "from": "$.sources.data.sensors.list",
      "with": {
        "by": "value",
        "direction": "descending"
      }
    },
    "topSensors": {
      "use": "limit",
      "from": "$.transforms.hottest",
      "with": {
        "count": 8
      }
    },
    "suffix1": {
      "use": "assign",
      "from": "switch(transforms.kind1, 'power', 'W', 'fan', ' rpm', 'fanUsage', '%', if(transforms.fahrenheit, '°F', '°'))"
    },
    "hasSecond": {
      "use": "assign",
      "from": "and(ne(transforms.sel2, 'none'), ne(transforms.raw2, null))"
    }
  },
  "view": {
    "switch": "${string(sources.data.sensors.available)}",
    "cases": {
      "true": {
        "type": "vstack",
        "spacing": 8,
        "children": [
          {
            "type": "hstack",
            "spacing": 6,
            "children": [
              {
                "type": "image",
                "source": {
                  "kind": "sfSymbol",
                  "name": "thermometer.medium"
                },
                "size": 14,
                "tint": "accent"
              },
              {
                "type": "text",
                "text": "Sensors",
                "role": "caption",
                "foreground": "secondary"
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "text": "${if(eq(sources.data.sensors.power, null), '', concat(string(round(number(sources.data.sensors.power), 1)), ' W'))}",
                "role": "caption",
                "monospacedDigit": true,
                "foreground": "secondary"
              }
            ]
          },
          {
            "type": "vstack",
            "spacing": 3,
            "children": [
              {
                "type": "hstack",
                "children": [
                  {
                    "type": "text",
                    "text": "CPU",
                    "role": "caption"
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "text": "${if(eq(sources.data.sensors.cpu, null), '—', concat(string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(sources.data.sensors.cpu,1.8),32), sources.data.sensors.cpu)), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C')))}",
                    "role": "caption",
                    "monospacedDigit": true,
                    "foreground": "${if(gt(sources.data.sensors.cpu, 90), 'danger', if(gt(sources.data.sensors.cpu, 75), 'warning', 'good'))}"
                  }
                ]
              },
              {
                "type": "progress",
                "style": "linear",
                "value": "${div(coalesce(sources.data.sensors.cpu, 0), 100)}",
                "tint": "${if(gt(sources.data.sensors.cpu, 90), 'danger', if(gt(sources.data.sensors.cpu, 75), 'warning', 'good'))}"
              }
            ]
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "text",
                "text": "GPU",
                "role": "caption"
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "text": "${if(eq(sources.data.sensors.gpu, null), '—', concat(string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(sources.data.sensors.gpu,1.8),32), sources.data.sensors.gpu)), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C')))}",
                "role": "caption",
                "monospacedDigit": true,
                "foreground": "secondary"
              }
            ]
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "text",
                "text": "Battery",
                "role": "caption"
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "text": "${if(eq(sources.data.sensors.battery, null), '—', concat(string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(sources.data.sensors.battery,1.8),32), sources.data.sensors.battery)), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C')))}",
                "role": "caption",
                "monospacedDigit": true,
                "foreground": "secondary"
              }
            ]
          },
          {
            "switch": "${string(gt(count(sources.data.sensors.fans), 0))}",
            "cases": {
              "true": {
                "type": "vstack",
                "spacing": 3,
                "children": {
                  "forEach": "$.sources.data.sensors.fans",
                  "as": "fan",
                  "template": {
                    "type": "hstack",
                    "id": "fan-${string(fan.index)}",
                    "children": [
                      {
                        "type": "text",
                        "text": "${fan.name}",
                        "role": "caption"
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "text",
                        "text": "${concat(string(round(number(fan.rpm), 0)), ' rpm')}",
                        "role": "caption",
                        "monospacedDigit": true,
                        "foreground": "secondary"
                      }
                    ]
                  }
                }
              },
              "false": {
                "type": "hstack",
                "children": [
                  {
                    "type": "text",
                    "text": "Fans",
                    "role": "caption"
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "text": "none",
                    "role": "caption",
                    "foreground": "secondary"
                  }
                ]
              }
            }
          },
          {
            "switch": "${string(gt(count(sources.data.sensors.list), 0))}",
            "cases": {
              "true": {
                "type": "vstack",
                "spacing": 3,
                "children": [
                  {
                    "type": "divider"
                  },
                  {
                    "type": "hstack",
                    "children": [
                      {
                        "type": "text",
                        "text": "All sensors",
                        "role": "caption",
                        "foreground": "secondary"
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "text",
                        "role": "caption",
                        "foreground": "secondary",
                        "monospacedDigit": true,
                        "text": "${concat(string(count(sources.data.sensors.list)), ' readings')}"
                      }
                    ]
                  },
                  {
                    "type": "vstack",
                    "spacing": 2,
                    "children": {
                      "forEach": "$.transforms.topSensors",
                      "as": "reading",
                      "template": {
                        "type": "hstack",
                        "id": "sensor-${reading.key}",
                        "children": [
                          {
                            "type": "text",
                            "text": "${reading.name}",
                            "role": "caption"
                          },
                          {
                            "type": "spacer"
                          },
                          {
                            "type": "text",
                            "role": "caption",
                            "monospacedDigit": true,
                            "foreground": "secondary",
                            "text": "${concat(string(round(number(if(and(eq(reading.kind,'temperature'), transforms.fahrenheit), add(mul(reading.value,1.8),32), reading.value)), 1)), if(and(eq(reading.kind,'temperature'), transforms.fahrenheit), ' °F', concat(' ', reading.unit)))}"
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "false": {
                "type": "spacer"
              }
            }
          }
        ]
      }
    },
    "default": {
      "type": "vstack",
      "spacing": 6,
      "children": [
        {
          "type": "hstack",
          "spacing": 6,
          "children": [
            {
              "type": "image",
              "source": {
                "kind": "sfSymbol",
                "name": "thermometer.medium"
              },
              "size": 14,
              "tint": "secondary"
            },
            {
              "type": "text",
              "text": "Sensors",
              "role": "caption",
              "foreground": "secondary"
            }
          ]
        },
        {
          "type": "text",
          "text": "No hardware sensors are readable on this Mac. Sandboxed builds and virtual machines have no SMC access.",
          "role": "caption",
          "foreground": "secondary"
        }
      ]
    }
  },
  "status": {
    "label": "${if(or(not(sources.data.sensors.available), eq(transforms.raw1, null)), '', concat(string(round(transforms.shown1, transforms.decimals)), transforms.suffix1))}",
    "tooltip": "${if(not(sources.data.sensors.available), 'No sensors available', concat(if(eq(transforms.raw1, null), concat(transforms.label1, ' unavailable'), concat(transforms.label1, ' ', concat(string(round(transforms.shown1, transforms.decimals)), if(eq(transforms.kind1,'fan'), ' ', ''), transforms.unit1))), if(transforms.hasSecond, concat(' · ', transforms.label2, ' ', concat(string(round(transforms.shown2, transforms.decimals)), if(eq(transforms.kind2,'fan'), ' ', ''), transforms.unit2)), '')))}",
    "prefix": "${transforms.prefix1}",
    "tint": "${if(and(transforms.isTemp1, gt(number(transforms.raw1), 90)), 'danger', if(and(transforms.isTemp1, gt(number(transforms.raw1), 75)), 'warning', ''))}",
    "metrics": [
      {
        "id": "${transforms.sel1}",
        "label": "${transforms.prefix1}",
        "number": "${transforms.shown1}",
        "format": "decimal",
        "unit": "${transforms.unit1}",
        "precision": 0,
        "accessibilityLabel": "${if(eq(transforms.raw1, null), '', concat(transforms.label1, ' ', string(round(transforms.shown1, transforms.decimals)), ' ', transforms.unit1))}"
      },
      {
        "id": "${if(transforms.hasSecond, transforms.sel2, '')}",
        "label": "${if(transforms.hasSecond, transforms.prefix2, '')}",
        "number": "${if(transforms.hasSecond, transforms.shown2, null)}",
        "unit": "${if(transforms.hasSecond, transforms.unit2, '')}",
        "precision": 0,
        "accessibilityLabel": "${if(transforms.hasSecond, concat(transforms.label2, ' ', string(round(transforms.shown2, transforms.decimals)), ' ', transforms.unit2), '')}"
      }
    ]
  }
}
