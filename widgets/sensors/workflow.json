{
  "$schema": "https://barshelf.jiun.dev/schema/workflow-0.1.json",
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Hardware sensors from the native `system` source: SMC temperatures and fans, with the Apple Silicon HID sensor plane as the fallback. Every reading is optional, so the view switches on sensors.available. Displayed temperatures are converted per `settings.unit`; the progress thresholds stay in Celsius because that is what they were calibrated against.",
  "sources": {
    "data": {
      "use": "system",
      "with": {
        "metrics": [
          "sensors"
        ],
        "detail": true
      }
    }
  },
  "transforms": {
    "isTemp": {
      "use": "assign",
      "from": "not(or(eq(settings.menuBarSensor,'power'), or(eq(settings.menuBarSensor,'fan'), eq(settings.menuBarSensor,'fanUsage'))))"
    },
    "fahrenheit": {
      "use": "assign",
      "from": "eq(settings.unit,'fahrenheit')"
    },
    "raw": {
      "use": "assign",
      "from": "if(eq(settings.menuBarSensor,'power'), sources.data.sensors.power, if(eq(settings.menuBarSensor,'fan'), sources.data.sensors.fans.0.rpm, if(eq(settings.menuBarSensor,'fanUsage'), sources.data.sensors.fans.0.usage, if(eq(settings.menuBarSensor,'gpu'), sources.data.sensors.gpu, if(eq(settings.menuBarSensor,'battery'), sources.data.sensors.battery, if(eq(settings.menuBarSensor,'peak'), sources.data.sensors.peak, sources.data.sensors.cpu))))))"
    },
    "shown": {
      "use": "assign",
      "from": "if(and(transforms.isTemp, transforms.fahrenheit), add(mul(number(transforms.raw), 1.8), 32), number(transforms.raw))"
    },
    "suffix": {
      "use": "assign",
      "from": "if(eq(settings.menuBarSensor,'power'), ' W', if(eq(settings.menuBarSensor,'fan'), ' rpm', if(eq(settings.menuBarSensor,'fanUsage'), '%', if(transforms.fahrenheit, '°F', '°'))))"
    },
    "decimals": {
      "use": "assign",
      "from": "0"
    },
    "hottest": {
      "use": "sort",
      "from": "$.sources.data.sensors.list",
      "with": {
        "by": "value",
        "direction": "descending"
      }
    },
    "topSensors": {
      "use": "limit",
      "from": "$.transforms.hottest",
      "with": {
        "count": 8
      }
    }
  },
  "view": {
    "switch": "${string(sources.data.sensors.available)}",
    "cases": {
      "true": {
        "type": "vstack",
        "spacing": 8,
        "children": [
          {
            "type": "hstack",
            "spacing": 6,
            "children": [
              {
                "type": "image",
                "source": {
                  "kind": "sfSymbol",
                  "name": "thermometer.medium"
                },
                "size": 14,
                "tint": "accent"
              },
              {
                "type": "text",
                "text": "Sensors",
                "role": "caption",
                "foreground": "secondary"
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "text": "${if(eq(sources.data.sensors.power, null), '', concat(string(round(number(sources.data.sensors.power), 1)), ' W'))}",
                "role": "caption",
                "monospacedDigit": true,
                "foreground": "secondary"
              }
            ]
          },
          {
            "type": "vstack",
            "spacing": 3,
            "children": [
              {
                "type": "hstack",
                "children": [
                  {
                    "type": "text",
                    "text": "CPU",
                    "role": "caption"
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "text": "${if(eq(sources.data.sensors.cpu, null), '—', concat(string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(sources.data.sensors.cpu,1.8),32), sources.data.sensors.cpu)), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C')))}",
                    "role": "caption",
                    "monospacedDigit": true,
                    "foreground": "${if(gt(sources.data.sensors.cpu, 90), 'danger', if(gt(sources.data.sensors.cpu, 75), 'warning', 'good'))}"
                  }
                ]
              },
              {
                "type": "progress",
                "style": "linear",
                "value": "${div(coalesce(sources.data.sensors.cpu, 0), 100)}",
                "tint": "${if(gt(sources.data.sensors.cpu, 90), 'danger', if(gt(sources.data.sensors.cpu, 75), 'warning', 'good'))}"
              }
            ]
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "text",
                "text": "GPU",
                "role": "caption"
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "text": "${if(eq(sources.data.sensors.gpu, null), '—', concat(string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(sources.data.sensors.gpu,1.8),32), sources.data.sensors.gpu)), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C')))}",
                "role": "caption",
                "monospacedDigit": true,
                "foreground": "secondary"
              }
            ]
          },
          {
            "type": "hstack",
            "children": [
              {
                "type": "text",
                "text": "Battery",
                "role": "caption"
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "text": "${if(eq(sources.data.sensors.battery, null), '—', concat(string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(sources.data.sensors.battery,1.8),32), sources.data.sensors.battery)), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C')))}",
                "role": "caption",
                "monospacedDigit": true,
                "foreground": "secondary"
              }
            ]
          },
          {
            "switch": "${string(gt(count(sources.data.sensors.fans), 0))}",
            "cases": {
              "true": {
                "type": "vstack",
                "spacing": 3,
                "children": {
                  "forEach": "$.sources.data.sensors.fans",
                  "as": "fan",
                  "template": {
                    "type": "hstack",
                    "id": "fan-${string(fan.index)}",
                    "children": [
                      {
                        "type": "text",
                        "text": "${fan.name}",
                        "role": "caption"
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "text",
                        "text": "${concat(string(round(number(fan.rpm), 0)), ' rpm')}",
                        "role": "caption",
                        "monospacedDigit": true,
                        "foreground": "secondary"
                      }
                    ]
                  }
                }
              },
              "false": {
                "type": "hstack",
                "children": [
                  {
                    "type": "text",
                    "text": "Fans",
                    "role": "caption"
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "text": "none",
                    "role": "caption",
                    "foreground": "secondary"
                  }
                ]
              }
            }
          },
          {
            "switch": "${string(gt(count(sources.data.sensors.list), 0))}",
            "cases": {
              "true": {
                "type": "vstack",
                "spacing": 3,
                "children": [
                  {
                    "type": "divider"
                  },
                  {
                    "type": "hstack",
                    "children": [
                      {
                        "type": "text",
                        "text": "All sensors",
                        "role": "caption",
                        "foreground": "secondary"
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "text",
                        "role": "caption",
                        "foreground": "secondary",
                        "monospacedDigit": true,
                        "text": "${concat(string(count(sources.data.sensors.list)), ' readings')}"
                      }
                    ]
                  },
                  {
                    "type": "vstack",
                    "spacing": 2,
                    "children": {
                      "forEach": "$.transforms.topSensors",
                      "as": "reading",
                      "template": {
                        "type": "hstack",
                        "id": "sensor-${reading.key}",
                        "children": [
                          {
                            "type": "text",
                            "text": "${reading.name}",
                            "role": "caption"
                          },
                          {
                            "type": "spacer"
                          },
                          {
                            "type": "text",
                            "role": "caption",
                            "monospacedDigit": true,
                            "foreground": "secondary",
                            "text": "${concat(string(round(number(if(and(eq(reading.kind,'temperature'), transforms.fahrenheit), add(mul(reading.value,1.8),32), reading.value)), 1)), if(and(eq(reading.kind,'temperature'), transforms.fahrenheit), ' °F', concat(' ', reading.unit)))}"
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "false": {
                "type": "spacer"
              }
            }
          }
        ]
      }
    },
    "default": {
      "type": "vstack",
      "spacing": 6,
      "children": [
        {
          "type": "hstack",
          "spacing": 6,
          "children": [
            {
              "type": "image",
              "source": {
                "kind": "sfSymbol",
                "name": "thermometer.medium"
              },
              "size": 14,
              "tint": "secondary"
            },
            {
              "type": "text",
              "text": "Sensors",
              "role": "caption",
              "foreground": "secondary"
            }
          ]
        },
        {
          "type": "text",
          "text": "No hardware sensors are readable on this Mac. Sandboxed builds and virtual machines have no SMC access.",
          "role": "caption",
          "foreground": "secondary"
        }
      ]
    }
  },
  "status": {
    "label": "${if(or(not(sources.data.sensors.available), eq(transforms.raw, null)), '', concat(string(round(transforms.shown, transforms.decimals)), transforms.suffix))}",
    "tooltip": "${if(sources.data.sensors.available, concat('CPU ', string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(coalesce(sources.data.sensors.cpu, 0),1.8),32), coalesce(sources.data.sensors.cpu, 0))), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C'), ' · peak ', string(round(number(if(eq(settings.unit,'fahrenheit'), add(mul(coalesce(sources.data.sensors.peak, 0),1.8),32), coalesce(sources.data.sensors.peak, 0))), 1)), if(eq(settings.unit,'fahrenheit'), ' °F', ' °C')), 'No sensors available')}",
    "prefix": "${if(eq(settings.menuBarSensor,'power'), 'Power', if(eq(settings.menuBarSensor,'fan'), 'Fan', if(eq(settings.menuBarSensor,'fanUsage'), 'Fan', if(eq(settings.menuBarSensor,'gpu'), 'GPU', if(eq(settings.menuBarSensor,'battery'), 'Batt', if(eq(settings.menuBarSensor,'peak'), 'Peak', 'CPU'))))))}",
    "tint": "${if(and(transforms.isTemp, gt(number(transforms.raw), 90)), 'danger', if(and(transforms.isTemp, gt(number(transforms.raw), 75)), 'warning', ''))}"
  }
}
