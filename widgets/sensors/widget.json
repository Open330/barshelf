{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.sensors",
  "name": "Sensors",
  "version": "0.1.0",
  "icon": "thermometer.medium",
  "bucket": {
    "group": "System",
    "order": 12,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 3,
    "staleAfterSec": 3
  },
  "statusItem": {
    "mode": "text",
    "icon": "thermometer.medium"
  },
  "permissions": {
    "system": [
      "sensors"
    ]
  },
  "settings": [
    {
      "key": "menuBarSensor",
      "title": "Menu bar shows",
      "type": "enum",
      "default": "cpu",
      "options": [
        "cpu",
        "gpu",
        "battery",
        "peak"
      ],
      "optionTitles": [
        "CPU",
        "GPU",
        "Battery",
        "Hottest sensor"
      ]
    },
    {
      "key": "unit",
      "title": "Temperature unit",
      "type": "enum",
      "default": "celsius",
      "options": [
        "celsius",
        "fahrenheit"
      ],
      "optionTitles": [
        "Celsius (\u00b0C)",
        "Fahrenheit (\u00b0F)"
      ]
    }
  ],
  "appearance": {
    "accent": "orange"
  }
}
