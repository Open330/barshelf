{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.internet-quality",
  "name": "Internet Quality",
  "version": "0.2.0",
  "minHostVersion": "0.7.22",
  "icon": "speedometer",
  "bucket": {
    "group": "System",
    "order": 15,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 300,
    "staleAfterSec": 300,
    "runInBackground": true
  },
  "permissions": {
    "exec": [
      {
        "command": "/bin/sh",
        "allowedArgs": [
          [
            "-c",
            "h=$1; case \"$h\" in ''|-*|*[!A-Za-z0-9.-]*) h=1.1.1.1;; esac; out=$(/sbin/ping -q -c 5 -i 0.2 -t 4 \"$h\" 2>/dev/null); loss=$(printf '%s' \"$out\" | /usr/bin/sed -n 's/.* \\([0-9.]*\\)% packet loss.*/\\1/p'); rtt=$(printf '%s' \"$out\" | /usr/bin/sed -n 's#.*= \\([0-9.]*\\)/\\([0-9.]*\\)/\\([0-9.]*\\)/\\([0-9.]*\\) ms#\\2 \\4#p'); if [ -n \"$rtt\" ]; then [ -n \"$loss\" ] || loss=0; set -- $rtt; printf '{\"ok\":true,\"avg\":%s,\"jitter\":%s,\"loss\":%s}' \"$1\" \"$2\" \"$loss\"; else [ -n \"$loss\" ] || loss=100; printf '{\"ok\":false,\"loss\":%s}' \"$loss\"; fi",
            "internet-quality",
            "*"
          ]
        ],
        "maxOutputBytes": 4096,
        "sensitiveOutput": false
      },
      {
        "command": "/bin/sh",
        "allowedArgs": [
          [
            "-c",
            "if [ \"$1\" = run ]; then /usr/bin/networkQuality -c -M 10 2>/dev/null || printf '{\"error\":true}'; else printf '{\"skipped\":true}'; fi",
            "internet-quality",
            "*"
          ]
        ],
        "maxOutputBytes": 262144,
        "sensitiveOutput": false
      }
    ],
    "storage": true,
    "notifications": true
  },
  "settings": [
    {
      "key": "schedule",
      "title": "Speed test",
      "type": "enum",
      "default": "daily",
      "options": [
        "daily",
        "6h",
        "manual"
      ],
      "optionTitles": [
        "Once a day",
        "Every 6 hours",
        "Only when I press Test now"
      ]
    },
    {
      "key": "pingHost",
      "title": "Ping host",
      "type": "string",
      "default": "1.1.1.1"
    },
    {
      "key": "slowMs",
      "title": "Unstable above (ms)",
      "type": "integer",
      "default": 300,
      "min": 50,
      "max": 2000
    },
    {
      "key": "alerts",
      "title": "Notify when the connection drops or turns unstable",
      "type": "boolean",
      "default": true
    }
  ],
  "statusItem": {
    "mode": "text",
    "icon": "speedometer"
  },
  "appearance": {
    "accent": "blue"
  },
  "localizations": {
    "ko": {
      "Internet Quality": "인터넷 품질",
      "Speed test": "속도 측정",
      "Once a day": "하루 한 번",
      "Every 6 hours": "6시간마다",
      "Only when I press Test now": "지금 측정을 누를 때만",
      "Notify when the connection drops or turns unstable": "연결이 끊기거나 불안정해지면 알림",
      "Download": "다운로드",
      "Upload": "업로드",
      "${transforms.rating} · ${transforms.rpm} RPM · tested ${transforms.testedAgo}": "${transforms.rating} · ${transforms.rpm} RPM · ${transforms.testedAgo} 측정",
      "No speed test yet. Each test moves a few hundred MB, for about 10 seconds.": "아직 속도를 측정하지 않았습니다. 측정 한 번에 약 10초 동안 수백 MB를 씁니다.",
      "Test now": "지금 측정",
      "The last test didn't finish.": "지난 측정이 끝나지 않았습니다.",
      "The internet connection is down": "인터넷 연결이 끊겼습니다",
      "The internet connection is unstable": "인터넷 연결이 불안정합니다",
      "Ping host": "핑 대상 호스트",
      "Unstable above (ms)": "불안정 기준 (ms 초과)",
      "No reply from ${transforms.host}.": "${transforms.host}에서 응답이 없습니다.",
      "${string(round(transforms.loss))}% loss, ${transforms.latency} ms to ${transforms.host}.": "${transforms.host}까지 손실 ${string(round(transforms.loss))}%, ${transforms.latency} ms."
    }
  }
}
