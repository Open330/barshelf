{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Internet speed and responsiveness from Apple's /usr/bin/networkQuality -c (JSON, ~10-20 s, capped at 30 s by -M). A test can move hundreds of MB to over 1 GB on a fast line, so this never polls: no interval, popupOnly (no wake/background runs), and onOpen only once the last result is older than staleAfterSec (6 h). The button reruns it on demand. Rating follows Apple's RPM bands: under 300 Low, 300-999 Medium, 1000+ High.",
  "sources": {
    "nq": {
      "use": "exec",
      "with": {
        "command": [
          "/usr/bin/networkQuality",
          "-c",
          "-M",
          "30"
        ],
        "timeoutMs": 45000,
        "maxOutputBytes": 262144
      }
    }
  },
  "transforms": {
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "dlBps": {
      "use": "assign",
      "from": "number(sources.nq.dl_throughput)"
    },
    "ulBps": {
      "use": "assign",
      "from": "number(sources.nq.ul_throughput)"
    },
    "rpmRaw": {
      "use": "assign",
      "from": "number(coalesce(sources.nq.responsiveness, sources.nq.dl_responsiveness))"
    },
    "ok": {
      "use": "assign",
      "from": "and(ne(transforms.dlBps, null), ne(transforms.ulBps, null))"
    },
    "down": {
      "use": "assign",
      "from": "if(eq(transforms.dlBps, null), '—', string(if(gte(transforms.dlBps, 100000000), round(div(transforms.dlBps, 1000000)), round(div(transforms.dlBps, 1000000), 1))))"
    },
    "up": {
      "use": "assign",
      "from": "if(eq(transforms.ulBps, null), '—', string(if(gte(transforms.ulBps, 100000000), round(div(transforms.ulBps, 1000000)), round(div(transforms.ulBps, 1000000), 1))))"
    },
    "rpm": {
      "use": "assign",
      "from": "if(eq(transforms.rpmRaw, null), '—', string(round(transforms.rpmRaw)))"
    },
    "band": {
      "use": "assign",
      "from": "if(eq(transforms.rpmRaw, null), 'unknown', if(lt(transforms.rpmRaw, 300), 'low', if(lt(transforms.rpmRaw, 1000), 'medium', 'high')))"
    },
    "rating": {
      "use": "assign",
      "from": "if(transforms.ko, switch(transforms.band, 'low', '낮음', 'medium', '보통', 'high', '높음', '알 수 없음'), switch(transforms.band, 'low', 'Low', 'medium', 'Medium', 'high', 'High', 'Unknown'))"
    },
    "tone": {
      "use": "assign",
      "from": "switch(transforms.band, 'low', 'danger', 'medium', 'warning', 'high', 'good', 'secondary')"
    },
    "idle": {
      "use": "assign",
      "from": "if(eq(number(sources.nq.base_rtt), null), '—', string(round(sources.nq.base_rtt)))"
    },
    "iface": {
      "use": "assign",
      "from": "coalesce(sources.nq.interface_name, '—')"
    },
    "when": {
      "use": "assign",
      "from": "date.clock(now())"
    }
  },
  "view": {
    "switch": "${if(transforms.ok, 'ok', 'fail')}",
    "cases": {
      "ok": {
        "type": "vstack",
        "spacing": 10,
        "children": [
          {
            "type": "hstack",
            "spacing": 16,
            "children": [
              {
                "type": "vstack",
                "spacing": 1,
                "desktopRole": "item",
                "children": [
                  {
                    "type": "text",
                    "text": "Download",
                    "role": "caption",
                    "foreground": "secondary",
                    "desktopRole": "title"
                  },
                  {
                    "type": "text",
                    "text": "${transforms.down} Mbps",
                    "role": "title",
                    "size": 22,
                    "monospacedDigit": true,
                    "lineLimit": 1,
                    "desktopRole": "value"
                  }
                ]
              },
              {
                "type": "vstack",
                "spacing": 1,
                "desktopRole": "item",
                "children": [
                  {
                    "type": "text",
                    "text": "Upload",
                    "role": "caption",
                    "foreground": "secondary",
                    "desktopRole": "title"
                  },
                  {
                    "type": "text",
                    "text": "${transforms.up} Mbps",
                    "role": "title",
                    "size": 22,
                    "monospacedDigit": true,
                    "lineLimit": 1,
                    "desktopRole": "value"
                  }
                ]
              },
              {
                "type": "spacer"
              }
            ]
          },
          {
            "type": "vstack",
            "spacing": 2,
            "desktopRole": "item",
            "children": [
              {
                "type": "text",
                "text": "Responsiveness",
                "role": "caption",
                "foreground": "secondary",
                "desktopRole": "title"
              },
              {
                "type": "hstack",
                "spacing": 6,
                "children": [
                  {
                    "type": "image",
                    "source": {
                      "kind": "sfSymbol",
                      "name": "${switch(transforms.band, 'low', 'gauge.with.dots.needle.0percent', 'medium', 'gauge.with.dots.needle.50percent', 'gauge.with.dots.needle.100percent')}"
                    },
                    "size": 15,
                    "tint": "${transforms.tone}"
                  },
                  {
                    "type": "text",
                    "text": "${transforms.rpm} RPM · ${transforms.rating}",
                    "role": "body",
                    "foreground": "${transforms.tone}",
                    "monospacedDigit": true,
                    "desktopRole": "value"
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "text": "Idle latency ${transforms.idle} ms · ${transforms.iface}",
            "role": "caption",
            "foreground": "secondary",
            "lineLimit": 1
          },
          {
            "type": "divider"
          },
          {
            "type": "hstack",
            "spacing": 8,
            "children": [
              {
                "type": "text",
                "text": "Tested at ${transforms.when}. Each test moves a lot of data, so it runs only when you open it after 6 hours or press Run test again.",
                "role": "caption",
                "foreground": "tertiary",
                "desktopRole": "hide"
              },
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Run test again",
                "icon": "arrow.clockwise",
                "action": {
                  "type": "refresh"
                }
              }
            ]
          }
        ]
      }
    },
    "default": {
      "type": "vstack",
      "spacing": 8,
      "children": [
        {
          "type": "empty",
          "icon": "wifi.exclamationmark",
          "title": "Couldn’t measure",
          "subtitle": "networkQuality returned no result. Check the connection and try again."
        },
        {
          "type": "button",
          "title": "Run test again",
          "icon": "arrow.clockwise",
          "action": {
            "type": "refresh"
          }
        }
      ]
    }
  },
  "status": {
    "label": "${if(transforms.ok, concat('↓', transforms.down), '—')}",
    "tooltip": "Download ${transforms.down} Mbps · Upload ${transforms.up} Mbps · ${transforms.rpm} RPM"
  }
}
