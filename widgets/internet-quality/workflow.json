{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Two measurements at two costs. Every refresh (5 min; ~20 min in the background) pings the Ping host setting (1.1.1.1 by default; a name or address, anything else falls back to 1.1.1.1) five times: latency, jitter, loss, almost no data, so it can sit in the menu bar and notify. The speed test (networkQuality, capped at 10 s) runs only when it is due by the schedule setting (daily by default, 6 h, or manual) or when the user presses Test now (widget.requested); its result and time are kept in storage between tests. A failed test keeps the last good result and waits for the next due time.",
  "sources": {
    "ping": {
      "use": "exec",
      "with": {
        "command": [
          "/bin/sh",
          "-c",
          "h=$1; case \"$h\" in ''|-*|*[!A-Za-z0-9.-]*) h=1.1.1.1;; esac; out=$(/sbin/ping -q -c 5 -i 0.2 -t 4 \"$h\" 2>/dev/null); loss=$(printf '%s' \"$out\" | /usr/bin/sed -n 's/.* \\([0-9.]*\\)% packet loss.*/\\1/p'); rtt=$(printf '%s' \"$out\" | /usr/bin/sed -n 's#.*= \\([0-9.]*\\)/\\([0-9.]*\\)/\\([0-9.]*\\)/\\([0-9.]*\\) ms#\\2 \\4#p'); if [ -n \"$rtt\" ]; then [ -n \"$loss\" ] || loss=0; set -- $rtt; printf '{\"ok\":true,\"avg\":%s,\"jitter\":%s,\"loss\":%s}' \"$1\" \"$2\" \"$loss\"; else [ -n \"$loss\" ] || loss=100; printf '{\"ok\":false,\"loss\":%s}' \"$loss\"; fi",
          "internet-quality",
          "${coalesce(settings.pingHost, '1.1.1.1')}"
        ],
        "timeoutMs": 10000
      }
    },
    "speed": {
      "use": "exec",
      "with": {
        "command": [
          "/bin/sh",
          "-c",
          "if [ \"$1\" = run ]; then /usr/bin/networkQuality -c -M 10 2>/dev/null || printf '{\"error\":true}'; else printf '{\"skipped\":true}'; fi",
          "internet-quality",
          "${if(or(widget.requested, and(ne(coalesce(settings.schedule, 'daily'), 'manual'), gte(sub(now(), coalesce(number(storage.speedAttemptMs), 0)), if(eq(settings.schedule, '6h'), 21600000, 86400000)))), 'run', 'skip')}"
        ],
        "timeoutMs": 25000,
        "maxOutputBytes": 262144
      }
    }
  },
  "transforms": {
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "pingOk": {
      "use": "assign",
      "from": "eq(sources.ping.ok, true)"
    },
    "avg": {
      "use": "assign",
      "from": "number(sources.ping.avg)"
    },
    "jitter": {
      "use": "assign",
      "from": "number(sources.ping.jitter)"
    },
    "loss": {
      "use": "assign",
      "from": "number(coalesce(sources.ping.loss, 100))"
    },
    "latency": {
      "use": "assign",
      "from": "if(or(not(transforms.pingOk), eq(transforms.avg, null)), '—', string(round(transforms.avg)))"
    },
    "health": {
      "use": "assign",
      "from": "if(not(transforms.pingOk), 'down', if(or(gte(transforms.loss, 20), gte(transforms.avg, transforms.slowMs)), 'unstable', if(or(gt(transforms.loss, 0), gte(transforms.avg, transforms.fairMs), gte(transforms.jitter, 30)), 'fair', 'good')))"
    },
    "healthText": {
      "use": "assign",
      "from": "if(transforms.ko, switch(transforms.health, 'down', '응답 없음', 'unstable', '불안정', 'fair', '보통', '좋음'), switch(transforms.health, 'down', 'No reply', 'unstable', 'Unstable', 'fair', 'Fair', 'Good'))"
    },
    "tone": {
      "use": "assign",
      "from": "switch(transforms.health, 'down', 'danger', 'unstable', 'danger', 'fair', 'warning', 'good')"
    },
    "speed": {
      "use": "assign",
      "from": "if(ne(number(sources.speed.dl_throughput), null), sources.speed, storage.speed)"
    },
    "speedAt": {
      "use": "assign",
      "from": "if(ne(number(sources.speed.dl_throughput), null), now(), number(storage.speedAt))"
    },
    "dlBps": {
      "use": "assign",
      "from": "number(transforms.speed.dl_throughput)"
    },
    "ulBps": {
      "use": "assign",
      "from": "number(transforms.speed.ul_throughput)"
    },
    "rpmRaw": {
      "use": "assign",
      "from": "number(coalesce(transforms.speed.responsiveness, transforms.speed.dl_responsiveness))"
    },
    "hasSpeed": {
      "use": "assign",
      "from": "ne(transforms.dlBps, null)"
    },
    "down": {
      "use": "assign",
      "from": "if(eq(transforms.dlBps, null), '—', string(if(gte(transforms.dlBps, 100000000), round(div(transforms.dlBps, 1000000)), round(div(transforms.dlBps, 1000000), 1))))"
    },
    "up": {
      "use": "assign",
      "from": "if(eq(transforms.ulBps, null), '—', string(if(gte(transforms.ulBps, 100000000), round(div(transforms.ulBps, 1000000)), round(div(transforms.ulBps, 1000000), 1))))"
    },
    "rpm": {
      "use": "assign",
      "from": "if(eq(transforms.rpmRaw, null), '—', string(round(transforms.rpmRaw)))"
    },
    "rating": {
      "use": "assign",
      "from": "if(eq(transforms.rpmRaw, null), '', if(transforms.ko, if(lt(transforms.rpmRaw, 300), '응답성 낮음', if(lt(transforms.rpmRaw, 1000), '응답성 보통', '응답성 높음')), if(lt(transforms.rpmRaw, 300), 'Low responsiveness', if(lt(transforms.rpmRaw, 1000), 'Medium responsiveness', 'High responsiveness'))))"
    },
    "testedAgo": {
      "use": "assign",
      "from": "if(eq(transforms.speedAt, null), '', date.relative(transforms.speedAt))"
    },
    "failed": {
      "use": "assign",
      "from": "eq(sources.speed.error, true)"
    },
    "alertsOn": {
      "use": "assign",
      "from": "coalesce(settings.alerts, true)"
    },
    "host": {
      "use": "assign",
      "from": "coalesce(settings.pingHost, '1.1.1.1')"
    },
    "slowMs": {
      "use": "assign",
      "from": "number(coalesce(settings.slowMs, 300))"
    },
    "fairMs": {
      "use": "assign",
      "from": "min(100, div(transforms.slowMs, 2))"
    }
  },
  "view": {
    "type": "vstack",
    "spacing": 10,
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "text",
            "text": "${if(transforms.pingOk, concat(transforms.latency, ' ms'), if(transforms.ko, '응답 없음', 'No reply'))}",
            "role": "title",
            "size": 26,
            "monospacedDigit": true,
            "lineLimit": 1
          },
          {
            "type": "badge",
            "text": "${transforms.healthText}",
            "tint": "${transforms.tone}"
          },
          {
            "type": "spacer"
          }
        ]
      },
      {
        "type": "text",
        "text": "${if(transforms.pingOk, concat(if(transforms.ko, '흔들림 ', 'Jitter '), string(round(coalesce(transforms.jitter, 0))), if(transforms.ko, ' ms · 손실 ', ' ms · loss '), string(round(transforms.loss)), '%'), if(transforms.ko, '핑에 응답이 없습니다', 'Pings got no answer'))} · ${transforms.host}",
        "role": "caption",
        "foreground": "secondary",
        "lineLimit": 1
      },
      {
        "type": "divider"
      },
      {
        "switch": "${if(transforms.hasSpeed, 'speed', 'none')}",
        "cases": {
          "speed": {
            "type": "vstack",
            "spacing": 4,
            "children": [
              {
                "type": "hstack",
                "spacing": 16,
                "children": [
                  {
                    "type": "vstack",
                    "spacing": 1,
                    "children": [
                      {
                        "type": "text",
                        "text": "Download",
                        "role": "caption",
                        "foreground": "secondary"
                      },
                      {
                        "type": "text",
                        "text": "${transforms.down} Mbps",
                        "role": "title",
                        "size": 18,
                        "monospacedDigit": true,
                        "lineLimit": 1
                      }
                    ]
                  },
                  {
                    "type": "vstack",
                    "spacing": 1,
                    "children": [
                      {
                        "type": "text",
                        "text": "Upload",
                        "role": "caption",
                        "foreground": "secondary"
                      },
                      {
                        "type": "text",
                        "text": "${transforms.up} Mbps",
                        "role": "title",
                        "size": 18,
                        "monospacedDigit": true,
                        "lineLimit": 1
                      }
                    ]
                  },
                  {
                    "type": "spacer"
                  }
                ]
              },
              {
                "type": "text",
                "text": "${transforms.rating} · ${transforms.rpm} RPM · tested ${transforms.testedAgo}",
                "role": "caption",
                "foreground": "secondary",
                "lineLimit": 1
              }
            ]
          },
          "none": {
            "type": "text",
            "text": "No speed test yet. Each test moves a few hundred MB, for about 10 seconds.",
            "role": "caption",
            "foreground": "secondary"
          }
        }
      },
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "button",
            "title": "Test now",
            "style": "bordered",
            "action": {
              "type": "refresh"
            }
          },
          {
            "switch": "${if(transforms.failed, 'failed', 'ok')}",
            "cases": {
              "failed": {
                "type": "text",
                "text": "The last test didn't finish.",
                "role": "caption",
                "foreground": "secondary"
              },
              "ok": {
                "type": "spacer"
              }
            }
          }
        ]
      }
    ]
  },
  "status": {
    "label": "${if(transforms.pingOk, concat(transforms.latency, ' ms'), if(transforms.ko, '응답 없음', 'No reply'))}",
    "tooltip": "${transforms.healthText} · ${transforms.host}${if(transforms.pingOk, concat(' ', transforms.latency, ' ms'), '')}${if(transforms.hasSpeed, concat(' · ', transforms.down, '/', transforms.up, ' Mbps'), '')}",
    "tint": "${if(eq(transforms.health, 'good'), '', transforms.tone)}"
  },
  "store": {
    "speed": {
      "value": "${transforms.speed}"
    },
    "speedAt": {
      "value": "${transforms.speedAt}"
    },
    "speedAttemptMs": {
      "value": "${if(eq(sources.speed.skipped, true), number(storage.speedAttemptMs), now())}"
    }
  },
  "alerts": {
    "offline": {
      "when": "${if(transforms.alertsOn, if(eq(sources.ping.ok, null), null, not(transforms.pingOk)), null)}",
      "title": "The internet connection is down",
      "body": "No reply from ${transforms.host}.",
      "cooldownSec": 900
    },
    "unstable": {
      "when": "${if(and(transforms.alertsOn, transforms.pingOk), or(gte(transforms.loss, 20), gte(transforms.avg, transforms.slowMs)), null)}",
      "title": "The internet connection is unstable",
      "body": "${string(round(transforms.loss))}% loss, ${transforms.latency} ms to ${transforms.host}.",
      "cooldownSec": 1800
    }
  }
}
