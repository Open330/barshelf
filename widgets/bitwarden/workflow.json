{
  "$schema": "https://barshelf.jiun.dev/schema/workflow-0.1.json",
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Bitwarden CLI vault status from `bw status` only: no session, no unlock, no sync, no item data. A fixed shell wrapper finds bw (Homebrew, npm under nvm/volta and similar; npm's bw is a node script, so its own bin folder goes first on PATH), and sed drops userEmail and userId before the output reaches BarShelf. BarShelf passes no BW_SESSION, so a logged-in vault reads as locked even while a terminal has it unlocked. A missing reading is null for the stale-sync alert. When the user presses Unlock, BarShelf's built-in Bitwarden provider (permissions.vault) unlocks the vault in BarShelf's own Bitwarden CLI profile (signed in once from the card, separate from the user's terminal bw so neither locks the other; vault.items reports account signedOut until then): the master password goes to bw through stdin, only the session is kept, in memory, and it locks after 10 minutes without a vault action, 60 minutes at most, on screen lock, sleep or quit. If the user ticks Touch ID at the password prompt, BarShelf keeps the session sealed to the Secure Enclave for 8 hours: idle, screen lock and sleep then lock softly and Touch ID reopens it (vault.items reports resumable and biometry); Lock locks bw completely. Sign Out (vaultSignOut, the host confirms first) signs BarShelf's profile out; the terminal profile is untouched. The vault.items source gives item names, usernames, hosts and opaque handles; copying a field is done by the host straight to the clipboard (cleared after 30 s). No secret reaches this workflow.",
  "sources": {
    "bw": {
      "use": "exec",
      "with": {
        "command": [
          "/bin/sh",
          "-c",
          "b=; for c in \"$(command -v bw 2>/dev/null)\" /opt/homebrew/bin/bw /usr/local/bin/bw \"$HOME\"/.nvm/versions/node/*/bin/bw \"$HOME/.volta/bin/bw\" \"$HOME/.npm-global/bin/bw\" \"$HOME/.local/bin/bw\" \"$HOME/Library/pnpm/bw\" \"$HOME/.bun/bin/bw\"; do if [ -n \"$c\" ] && [ -x \"$c\" ]; then b=$c; break; fi; done; if [ -z \"$b\" ]; then printf '{\"installed\":false}'; exit 0; fi; out=$(PATH=\"$(/usr/bin/dirname \"$b\"):$PATH\" BW_NOINTERACTION=true \"$b\" status 2>/dev/null) || { printf '{\"installed\":true,\"ok\":false}'; exit 0; }; case \"$out\" in \"{\"*) ;; *) printf '{\"installed\":true,\"ok\":false}'; exit 0;; esac; o='{\"installed\":true,\"ok\":true}'; for k in status lastSync serverUrl; do v=$(printf '%s' \"$out\" | /usr/bin/plutil -extract \"$k\" raw -o - - 2>/dev/null) && o=$(printf '%s' \"$o\" | /usr/bin/plutil -insert \"$k\" -string \"$v\" -o - -); done; printf '%s' \"$o\"",
          "bitwarden"
        ],
        "timeoutMs": 20000
      }
    },
    "vault": {
      "use": "vault.items"
    }
  },
  "transforms": {
    "ko": {
      "use": "assign",
      "from": "or(eq(coalesce(widget.locale, ''), 'ko'), or(eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko-…'), eq(text.truncate(coalesce(widget.locale, ''), 3), 'ko_…')))"
    },
    "ok": {
      "use": "assign",
      "from": "and(ne(sources.bw.installed, false), ne(sources.bw.ok, false), ne(string(sources.bw.status), ''))"
    },
    "state": {
      "use": "assign",
      "from": "if(eq(sources.bw.installed, false), 'missing', if(ne(coalesce(sources.vault.state, ''), ''), if(eq(sources.vault.state, 'unlocked'), 'unlocked', if(eq(coalesce(sources.vault.account, ''), 'signedOut'), 'unauthenticated', 'locked')), if(transforms.ok, sources.bw.status, 'error')))"
    },
    "stateWord": {
      "use": "assign",
      "from": "if(transforms.unlocked, if(transforms.ko, '열림', 'Unlocked'), if(transforms.ko, switch(transforms.state, 'locked', '잠김', 'unlocked', '잠금 해제됨', 'unauthenticated', '로그인 필요', 'missing', 'bw 없음', '읽을 수 없음'), switch(transforms.state, 'locked', 'Locked', 'unlocked', 'Unlocked', 'unauthenticated', 'Sign in needed', 'missing', 'bw not found', 'Unreadable')))"
    },
    "icon": {
      "use": "assign",
      "from": "switch(transforms.state, 'locked', 'lock.fill', 'unlocked', 'lock.open.fill', 'unauthenticated', 'person.crop.circle.badge.xmark', 'lock.slash')"
    },
    "tint": {
      "use": "assign",
      "from": "switch(transforms.state, 'locked', 'good', 'unlocked', 'warning', 'unauthenticated', 'secondary', 'secondary')"
    },
    "syncMs": {
      "use": "assign",
      "from": "date.ms(coalesce(sources.vault.lastSync, sources.bw.lastSync))"
    },
    "ageDays": {
      "use": "assign",
      "from": "if(eq(transforms.syncMs, null), null, div(sub(now(), transforms.syncMs), 86400000))"
    },
    "stale": {
      "use": "assign",
      "from": "and(ne(transforms.ageDays, null), gt(coalesce(transforms.ageDays, 0), coalesce(settings.staleDays, 7)))"
    },
    "syncText": {
      "use": "assign",
      "from": "if(eq(transforms.syncMs, null), if(transforms.ko, '없음', 'Never'), date.relative(transforms.syncMs))"
    },
    "server": {
      "use": "assign",
      "from": "if(eq(string(coalesce(sources.vault.server, sources.bw.serverUrl)), ''), if(transforms.ko, 'bitwarden.com (기본)', 'bitwarden.com (default)'), coalesce(sources.vault.server, sources.bw.serverUrl))"
    },
    "staleReading": {
      "use": "assign",
      "from": "if(and(transforms.ok, ne(transforms.state, 'unauthenticated'), ne(transforms.syncMs, null), coalesce(settings.alertOnStale, true)), transforms.stale, null)"
    },
    "alertTitle": {
      "use": "assign",
      "from": "if(transforms.ko, concat('Bitwarden을 ', string(round(coalesce(transforms.ageDays, 0))), '일 동안 동기화하지 않았습니다'), concat('Bitwarden hasn’t synced in ', string(round(coalesce(transforms.ageDays, 0))), ' days'))"
    },
    "alertBody": {
      "use": "assign",
      "from": "if(transforms.ko, 'BarShelf에서 잠금을 해제하면 동기화됩니다.', 'Unlocking it in BarShelf syncs it.')"
    },
    "unlocked": {
      "use": "assign",
      "from": "eq(sources.vault.state, 'unlocked')"
    },
    "vaultError": {
      "use": "assign",
      "from": "coalesce(sources.vault.error, '')"
    },
    "rows": {
      "use": "assign",
      "from": "coalesce(sources.vault.items, [])"
    },
    "countText": {
      "use": "assign",
      "from": "if(transforms.ko, concat('항목 ', string(coalesce(sources.vault.count, 0)), '개'), concat(string(coalesce(sources.vault.count, 0)), ' items'))"
    },
    "touchReady": {
      "use": "assign",
      "from": "and(coalesce(sources.vault.resumable, false), eq(coalesce(sources.vault.biometry, ''), 'touchID'))"
    },
    "unlocking": {
      "use": "assign",
      "from": "eq(coalesce(sources.vault.state, ''), 'unlocking')"
    },
    "signedOut": {
      "use": "assign",
      "from": "eq(coalesce(sources.vault.account, ''), 'signedOut')"
    }
  },
  "view": {
    "switch": "${if(transforms.unlocked, 'unlocked', 'locked')}",
    "cases": {
      "unlocked": {
        "type": "vstack",
        "spacing": 6,
        "children": [
          {
            "type": "hstack",
            "spacing": 6,
            "children": [
              {
                "type": "image",
                "source": {
                  "kind": "sfSymbol",
                  "name": "lock.open.fill"
                },
                "size": 13,
                "tint": "good"
              },
              {
                "type": "text",
                "text": "${transforms.countText}",
                "role": "caption",
                "foreground": "secondary"
              },
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "Lock",
                "icon": "lock",
                "action": {
                  "type": "vaultLock"
                }
              }
            ]
          },
          {
            "type": "list",
            "spacing": 2,
            "searchPlaceholder": "Search vault",
            "items": {
              "forEach": "$.transforms.rows",
              "as": "it",
              "template": {
                "type": "hstack",
                "id": "${it.handle}",
                "spacing": 6,
                "padding": 4,
                "desktopRole": "hide",
                "children": [
                  {
                    "type": "vstack",
                    "spacing": 1,
                    "widthFill": true,
                    "children": [
                      {
                        "type": "text",
                        "text": "${it.name}",
                        "role": "body",
                        "lineLimit": 1
                      },
                      {
                        "type": "text",
                        "text": "${coalesce(it.username, '')}${if(and(it.username, it.host), ' · ', '')}${coalesce(it.host, '')}",
                        "role": "caption",
                        "foreground": "secondary",
                        "lineLimit": 1
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "icon": "person",
                    "hidden": "${not(it.hasUsername)}",
                    "action": {
                      "type": "vaultCopy",
                      "value": "${it.handle}",
                      "field": "username"
                    },
                    "accessibilityLabel": "Copy username"
                  },
                  {
                    "type": "button",
                    "icon": "key",
                    "action": {
                      "type": "vaultCopy",
                      "value": "${it.handle}",
                      "field": "password"
                    },
                    "accessibilityLabel": "Copy password"
                  },
                  {
                    "type": "button",
                    "icon": "clock.badge.checkmark",
                    "hidden": "${not(it.totp)}",
                    "action": {
                      "type": "vaultCopy",
                      "value": "${it.handle}",
                      "field": "totp"
                    },
                    "accessibilityLabel": "Copy verification code"
                  }
                ]
              }
            }
          }
        ]
      },
      "locked": {
        "type": "vstack",
        "spacing": 8,
        "children": [
          {
            "type": "vstack",
            "spacing": 8,
            "children": [
              {
                "type": "hstack",
                "spacing": 8,
                "children": [
                  {
                    "type": "image",
                    "source": {
                      "kind": "sfSymbol",
                      "name": "${transforms.icon}"
                    },
                    "size": 22,
                    "tint": "${transforms.tint}"
                  },
                  {
                    "type": "text",
                    "text": "${transforms.stateWord}",
                    "role": "title",
                    "lineLimit": 1
                  },
                  {
                    "type": "spacer"
                  }
                ]
              },
              {
                "switch": "${transforms.state}",
                "cases": {
                  "missing": {
                    "type": "empty",
                    "icon": "lock.slash",
                    "title": "Bitwarden CLI not found",
                    "subtitle": "Install it with Homebrew (bitwarden-cli) or npm (@bitwarden/cli)."
                  },
                  "error": {
                    "type": "banner",
                    "icon": "exclamationmark.triangle",
                    "tone": "warning",
                    "text": "bw status did not answer. Check the Bitwarden CLI in Terminal."
                  },
                  "unauthenticated": {
                    "type": "banner",
                    "icon": "person.crop.circle.badge.questionmark",
                    "tone": "secondary",
                    "text": "BarShelf keeps its own Bitwarden sign-in, separate from Terminal. Sign in once below."
                  }
                },
                "default": {
                  "type": "vstack",
                  "spacing": 5,
                  "children": [
                    {
                      "type": "hstack",
                      "spacing": 6,
                      "children": [
                        {
                          "type": "text",
                          "text": "Last sync",
                          "role": "caption",
                          "foreground": "secondary"
                        },
                        {
                          "type": "spacer"
                        },
                        {
                          "type": "text",
                          "text": "${transforms.syncText}",
                          "role": "caption",
                          "foreground": "${if(transforms.stale, 'warning', 'primary')}"
                        }
                      ]
                    },
                    {
                      "type": "hstack",
                      "spacing": 6,
                      "children": [
                        {
                          "type": "text",
                          "text": "Server",
                          "role": "caption",
                          "foreground": "secondary"
                        },
                        {
                          "type": "spacer"
                        },
                        {
                          "type": "text",
                          "text": "${transforms.server}",
                          "role": "caption",
                          "lineLimit": 1,
                          "truncation": "middle"
                        }
                      ]
                    },
                    {
                      "switch": "${if(transforms.stale, 'stale', 'fresh')}",
                      "cases": {
                        "stale": {
                          "type": "banner",
                          "icon": "arrow.triangle.2.circlepath",
                          "tone": "warning",
                          "text": "Not synced for more than ${string(coalesce(settings.staleDays, 7))} days."
                        }
                      },
                      "default": {
                        "type": "none"
                      }
                    },
                    {
                      "type": "hstack",
                      "spacing": 6,
                      "children": [
                        {
                          "type": "text",
                          "text": "Unlocking happens in BarShelf's own prompt. This widget never sees a password.",
                          "role": "caption",
                          "foreground": "tertiary",
                          "lineLimit": 2,
                          "widthFill": true
                        },
                        {
                          "type": "button",
                          "title": "Sign Out…",
                          "icon": "rectangle.portrait.and.arrow.right",
                          "hidden": "${transforms.unlocking}",
                          "action": {
                            "type": "vaultSignOut"
                          },
                          "accessibilityLabel": "Sign out of Bitwarden in BarShelf"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "switch": "${if(eq(transforms.vaultError, ''), 'none', 'error')}",
            "cases": {
              "none": {
                "type": "spacer"
              },
              "error": {
                "type": "text",
                "text": "${transforms.vaultError}",
                "role": "caption",
                "foreground": "secondary"
              }
            }
          },
          {
            "switch": "${if(transforms.unlocking, 'busy', if(transforms.signedOut, 'signin', if(transforms.touchReady, 'touch', 'password')))}",
            "cases": {
              "busy": {
                "type": "hstack",
                "spacing": 8,
                "children": [
                  {
                    "type": "image",
                    "source": {
                      "kind": "sfSymbol",
                      "name": "hourglass"
                    },
                    "foreground": "secondary"
                  },
                  {
                    "type": "text",
                    "text": "Unlocking…",
                    "role": "headline"
                  },
                  {
                    "type": "text",
                    "text": "Bitwarden is checking the master password; this takes a few seconds.",
                    "role": "caption",
                    "foreground": "secondary",
                    "lineLimit": 2
                  }
                ]
              },
              "signin": {
                "type": "hstack",
                "spacing": 8,
                "children": [
                  {
                    "type": "button",
                    "title": "Sign In",
                    "icon": "person.crop.circle.badge.checkmark",
                    "style": "borderedProminent",
                    "action": {
                      "type": "vaultUnlock"
                    }
                  },
                  {
                    "type": "text",
                    "text": "Once, with your server, email and master password.",
                    "role": "caption",
                    "foreground": "secondary",
                    "lineLimit": 2
                  }
                ]
              },
              "touch": {
                "type": "hstack",
                "spacing": 8,
                "children": [
                  {
                    "type": "button",
                    "title": "Unlock with Touch ID",
                    "icon": "touchid",
                    "style": "borderedProminent",
                    "action": {
                      "type": "vaultUnlock"
                    }
                  },
                  {
                    "type": "button",
                    "title": "Use Password",
                    "style": "bordered",
                    "action": {
                      "type": "vaultUnlock",
                      "value": "password"
                    }
                  }
                ]
              },
              "password": {
                "type": "hstack",
                "spacing": 8,
                "children": [
                  {
                    "type": "button",
                    "title": "Unlock",
                    "icon": "lock.open",
                    "style": "borderedProminent",
                    "action": {
                      "type": "vaultUnlock"
                    }
                  },
                  {
                    "type": "text",
                    "text": "BarShelf asks for your master password and keeps only the session.",
                    "role": "caption",
                    "foreground": "secondary",
                    "lineLimit": 2
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "status": {
    "label": "${transforms.stateWord}",
    "icon": "${transforms.icon}",
    "tint": "${if(transforms.stale, 'warning', '')}",
    "tooltip": "Bitwarden: ${transforms.stateWord} · ${transforms.syncText}"
  },
  "alerts": {
    "stale": {
      "when": "${transforms.staleReading}",
      "title": "${transforms.alertTitle}",
      "body": "${transforms.alertBody}",
      "cooldownSec": 86400
    }
  }
}
