{
  "$schema": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "schemaVersion": 1,
  "id": "dev.barshelf.world-clock",
  "name": "World Clock",
  "version": "0.2.1",
  "minHostVersion": "0.7.21",
  "icon": "globe",
  "bucket": {
    "group": "Everyday",
    "order": 41,
    "size": "M"
  },
  "entry": {
    "kind": "workflow",
    "main": "workflow.json"
  },
  "refresh": {
    "onOpen": true,
    "interval": 60,
    "staleAfterSec": 60,
    "triggers": [
      "wake"
    ]
  },
  "statusItem": {
    "mode": "text",
    "icon": "globe"
  },
  "permissions": {
    "exec": [
      {
        "command": "/bin/sh",
        "purpose": "Read the time in the cities you choose",
        "allowedArgs": [
          [
            "-c",
            "f='{\"time\":\"%H:%M\",\"hour\":1%H,\"ymd\":%Y%m%d,\"wd\":%u,\"off\":\"%z\"}'; printf '{\"local\":%s' \"$(/bin/date \"+$f\")\"; i=0; for z in \"$@\"; do i=$((i+1)); if [ -z \"$z\" ]; then printf ',\"z%d\":null' \"$i\"; elif [ -f \"/usr/share/zoneinfo/$z\" ]; then printf ',\"z%d\":%s' \"$i\" \"$(TZ=\"$z\" /bin/date \"+$f\")\"; else printf ',\"z%d\":{\"invalid\":true}' \"$i\"; fi; done; echo '}'",
            "world-clock",
            "*",
            "*",
            "*",
            "*",
            "*"
          ]
        ],
        "maxOutputBytes": 4096,
        "sensitiveOutput": false
      }
    ]
  },
  "settings": [
    {
      "key": "label1",
      "title": "City 1 name",
      "type": "string",
      "default": "Seoul"
    },
    {
      "key": "zone1",
      "title": "City 1 time zone",
      "type": "string",
      "default": "Asia/Seoul"
    },
    {
      "key": "label2",
      "title": "City 2 name",
      "type": "string",
      "default": "San Francisco"
    },
    {
      "key": "zone2",
      "title": "City 2 time zone",
      "type": "string",
      "default": "America/Los_Angeles"
    },
    {
      "key": "label3",
      "title": "City 3 name",
      "type": "string",
      "default": "New York"
    },
    {
      "key": "zone3",
      "title": "City 3 time zone",
      "type": "string",
      "default": "America/New_York"
    },
    {
      "key": "label4",
      "title": "City 4 name",
      "type": "string",
      "default": "London"
    },
    {
      "key": "zone4",
      "title": "City 4 time zone",
      "type": "string",
      "default": "Europe/London"
    },
    {
      "key": "label5",
      "title": "City 5 name",
      "type": "string",
      "default": ""
    },
    {
      "key": "zone5",
      "title": "City 5 time zone",
      "type": "string",
      "default": ""
    },
    {
      "key": "menuBarCity",
      "title": "Menu bar shows",
      "type": "enum",
      "default": "2",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "optionTitles": [
        "City 1",
        "City 2",
        "City 3",
        "City 4",
        "City 5"
      ]
    },
    {
      "key": "workStart",
      "title": "Working hours start",
      "type": "integer",
      "default": 9,
      "min": 0,
      "max": 23
    },
    {
      "key": "workEnd",
      "title": "Working hours end",
      "type": "integer",
      "default": 18,
      "min": 1,
      "max": 24
    }
  ],
  "appearance": {
    "accent": "purple"
  },
  "localizations": {
    "ko": {
      "Read the time in the cities you choose": "고른 도시의 현재 시각 읽기",
      "World Clock": "세계 시계",
      "City 1 name": "도시 1 이름",
      "City 1 time zone": "도시 1 시간대",
      "City 2 name": "도시 2 이름",
      "City 2 time zone": "도시 2 시간대",
      "City 3 name": "도시 3 이름",
      "City 3 time zone": "도시 3 시간대",
      "City 4 name": "도시 4 이름",
      "City 4 time zone": "도시 4 시간대",
      "City 5 name": "도시 5 이름",
      "City 5 time zone": "도시 5 시간대",
      "Menu bar shows": "메뉴 막대에 표시",
      "City 1": "도시 1",
      "City 2": "도시 2",
      "City 3": "도시 3",
      "City 4": "도시 4",
      "City 5": "도시 5",
      "Working hours start": "업무 시작 시각",
      "Working hours end": "업무 종료 시각",
      "No cities": "도시 없음",
      "Add a city and an IANA time zone such as Asia/Seoul in widget settings.": "위젯 설정에서 도시와 Asia/Seoul 같은 IANA 시간대를 추가하세요.",
      "Dimmed outside working hours (${string(settings.workStart)}:00–${string(settings.workEnd)}:00) and on weekends": "업무 시간(${string(settings.workStart)}:00–${string(settings.workEnd)}:00) 밖과 주말은 흐리게 표시",
      "${string(transforms.badCount)} time zone name not recognized. Use an IANA name such as Europe/Paris.": "알 수 없는 시간대 이름 ${string(transforms.badCount)}개. Europe/Paris 같은 IANA 이름을 쓰세요."
    }
  }
}
