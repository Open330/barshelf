<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the widget extension (R14). Team-prefixed, so a Developer
	     ID build needs no provisioning profile and macOS asks no question. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>728FW73BS8.com.barshelf.shared</string>
	</array>
</dict>
</plist>
