{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://barshelf.jiun.dev/schema/workflow-0.1.json",
  "title": "BarShelf Workflow v0.1",
  "description": "Declarative workflow DSL v1. Host I/O lives in sources, pure transforms live in transforms, and view/empty are UINode templates. Expressions are not JavaScript; interpolation is allowed only inside ${...}. Supported built-ins: now(), count(list), date.relative(ms), file.basename(path), file.extension(path), text.truncate(s,n), coalesce(a,b,...).",
  "type": "object",
  "required": [
    "schemaVersion",
    "sources",
    "transforms",
    "view"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "description": "Named I/O sources executed by the host.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/source"
      }
    },
    "transforms": {
      "description": "Named pure transforms. v1 supports assign, filter, sort, and limit.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/transform"
      }
    },
    "view": {
      "$ref": "#/definitions/uiNodeTemplate"
    },
    "empty": {
      "$ref": "#/definitions/uiNodeTemplate"
    },
    "status": {
      "$ref": "#/definitions/status"
    }
  },
  "additionalProperties": true,
  "definitions": {
    "source": {
      "type": "object",
      "required": [
        "use",
        "with"
      ],
      "properties": {
        "use": {
          "type": "string",
          "enum": [
            "exec",
            "fs.directory",
            "http",
            "system",
            "value"
          ]
        },
        "with": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "use": {
                "const": "fs.directory"
              }
            },
            "required": [
              "use"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "$ref": "#/definitions/fsDirectoryOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "use": {
                "const": "exec"
              }
            },
            "required": [
              "use"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "$ref": "#/definitions/execOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "use": {
                "const": "system"
              }
            },
            "required": [
              "use"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "$ref": "#/definitions/systemOptions"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "fsDirectoryOptions": {
      "description": "Lists one directory. Output items expose id, path, name, modifiedAt (Unix ms), size (bytes), isDirectory, and ext.",
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/templateString"
        },
        "watch": {
          "type": "boolean"
        },
        "skipHidden": {
          "type": "boolean"
        },
        "sortBy": {
          "type": "string",
          "enum": [
            "modifiedAt",
            "name",
            "size",
            "path",
            "ext",
            "isDirectory"
          ]
        },
        "sortDirection": {
          "type": "string",
          "enum": [
            "ascending",
            "descending"
          ]
        },
        "limit": {
          "$ref": "#/definitions/templateInteger"
        }
      },
      "additionalProperties": true
    },
    "execOptions": {
      "description": "Runs a manifest-allowlisted command through the host ExecService. command is argv, not a shell string.",
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/templateString"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "output": {
          "type": "string",
          "enum": [
            "json",
            "data"
          ]
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "transform": {
      "type": "object",
      "required": [
        "use"
      ],
      "properties": {
        "use": {
          "type": "string",
          "enum": [
            "assign",
            "filter",
            "sort",
            "limit"
          ]
        },
        "from": {
          "$ref": "#/definitions/jsonPath"
        },
        "with": {
          "type": "object",
          "additionalProperties": true
        },
        "where": {
          "description": "Boolean expression for filter transforms. Expressions use the same limited DSL as interpolation.",
          "type": "string"
        },
        "by": {
          "description": "Sort key path or expression.",
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "ascending",
            "descending"
          ]
        },
        "count": {
          "$ref": "#/definitions/templateInteger"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "use": {
                "enum": [
                  "assign",
                  "filter",
                  "sort",
                  "limit"
                ]
              }
            },
            "required": [
              "use"
            ]
          },
          "then": {
            "required": [
              "from"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "uiNodeTemplate": {
      "description": "A UINode template. String fields may contain ${...} interpolation. children/items can be arrays or a forEach template object.",
      "type": "object",
      "anyOf": [
        { "required": ["type"] },
        { "required": ["switch"] }
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "switch": {
          "$ref": "#/definitions/templateString"
        },
        "children": {
          "$ref": "#/definitions/nodeCollectionTemplate"
        },
        "items": {
          "$ref": "#/definitions/nodeCollectionTemplate"
        },
        "child": {
          "$ref": "#/definitions/uiNodeTemplate"
        },
        "empty": {
          "$ref": "#/definitions/uiNodeTemplate"
        },
        "cases": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/uiNodeTemplate"
          }
        },
        "default": {
          "$ref": "#/definitions/uiNodeTemplate"
        },
        "source": {
          "$ref": "#/definitions/imageSourceTemplate"
        },
        "fallback": {
          "$ref": "#/definitions/imageSourceTemplate"
        },
        "drag": {
          "$ref": "#/definitions/dragTemplate"
        }
      },
      "additionalProperties": true
    },
    "nodeCollectionTemplate": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/uiNodeTemplate"
          }
        },
        {
          "$ref": "#/definitions/forEachTemplate"
        }
      ]
    },
    "forEachTemplate": {
      "description": "Repeats a UINode template for each item in a JSONPath result.",
      "type": "object",
      "required": [
        "forEach",
        "as",
        "template"
      ],
      "properties": {
        "forEach": {
          "$ref": "#/definitions/jsonPath"
        },
        "as": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "$ref": "#/definitions/uiNodeTemplate"
        }
      },
      "additionalProperties": false
    },
    "imageSourceTemplate": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "sfSymbol",
            "asset",
            "fileIcon",
            "fileThumbnail",
            "url",
            "data"
          ]
        },
        "name": {
          "$ref": "#/definitions/templateString"
        },
        "path": {
          "$ref": "#/definitions/templateString"
        },
        "modifiedAt": {
          "$ref": "#/definitions/templateNumber"
        },
        "url": {
          "$ref": "#/definitions/templateString"
        },
        "value": {
          "$ref": "#/definitions/templateString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fileIcon"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fileThumbnail"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "path",
              "modifiedAt"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "dragTemplate": {
      "type": "object",
      "required": [
        "filePath"
      ],
      "properties": {
        "filePath": {
          "$ref": "#/definitions/templateString"
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/definitions/templateString"
        },
        "tooltip": {
          "$ref": "#/definitions/templateString"
        },
        "prefix": {
          "type": "string",
          "description": "Templated text the menu bar draws before the value. Lets a widget whose metric the user picks say \"CPU\" or \"Mem\" as appropriate."
        },
        "icon": {
          "type": "string",
          "description": "SF Symbol for this refresh, overriding `statusItem.icon`. Lets an icon follow a value \u2014 a battery moving between `battery.25` and `battery.100`, say \u2014 which a fixed manifest field cannot."
        },
        "tint": {
          "$ref": "#/definitions/templateString",
          "description": "Colour for this refresh, from the same vocabulary the view layer uses. Omit it for the menu bar's own colour, which also keeps the item a template image \u2014 it then follows a light or dark bar and inverts while held open, neither of which a fixed colour can do."
        },
        "metrics": {
          "description": "Up to two independently active menu-bar metrics. Labels and values are templates; an active metric can be rendered as an activity dot when its value is empty.",
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/definitions/statusMetric"
          }
        },
        "presentation": {
          "$ref": "#/definitions/statusPresentation"
        }
      },
      "additionalProperties": true
    },
    "statusMetric": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/templateString", "description": "Stable id for ordering and per-metric presentation overrides." },
        "label": { "$ref": "#/definitions/templateString", "description": "Short visible label. Defaults to an empty string." },
        "value": { "$ref": "#/definitions/templateString", "description": "Visible reading. Defaults to an empty string." },
        "number": {
          "oneOf": [
            { "$ref": "#/definitions/templateNumber" },
            { "type": "null" }
          ],
          "description": "Machine-readable finite numeric value; null is an unknown reading."
        },
        "format": { "$ref": "#/definitions/templateString", "description": "decimal, percent (0–100), bytes, or bytesPerSecond. Byte units use SI base 1000." },
        "unit": { "$ref": "#/definitions/templateString", "description": "Optional unit appended to a decimal metric." },
        "precision": { "$ref": "#/definitions/metricPrecision", "description": "0 through 3 decimal places." },
        "tint": {
          "$ref": "#/definitions/templateString",
          "description": "Optional semantic tint: accent, good, warning, danger, or secondary."
        },
        "active": {
          "oneOf": [
            { "type": "boolean" },
            { "$ref": "#/definitions/templateString" }
          ],
          "description": "Optional activity state. A template must resolve to a boolean."
        },
        "accessibilityLabel": {
          "$ref": "#/definitions/templateString",
          "description": "Spoken description for this metric, including a value when the visible value is intentionally hidden."
        }
      },
      "additionalProperties": false
    },
    "statusPresentation": {
      "description": "Sparse per-render defaults. User preferences win over these values, which win over statusItem.presentation. Boolean and numeric fields may be literal or ${...} templates.",
      "type": "object",
      "properties": {
        "showValues": { "$ref": "#/definitions/templateBoolean" },
        "showUnits": { "$ref": "#/definitions/templateBoolean" },
        "precision": { "$ref": "#/definitions/metricPrecision" },
        "color": { "$ref": "#/definitions/templateString" },
        "valueWidth": { "$ref": "#/definitions/templateNumber" },
        "width": { "$ref": "#/definitions/templateString" },
        "digits": { "$ref": "#/definitions/templateNumber" },
        "alignment": { "$ref": "#/definitions/templateString" },
        "weight": { "$ref": "#/definitions/templateString" },
        "size": { "$ref": "#/definitions/templateString" },
        "numberAlignment": { "$ref": "#/definitions/templateString" },
        "metricOrder": {
          "type": "array",
          "items": { "$ref": "#/definitions/stableMetricId" },
          "uniqueItems": true
        },
        "metricOverrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/stableMetricId" },
          "additionalProperties": { "$ref": "#/definitions/menuBarMetricOverride" }
        }
      },
      "additionalProperties": false
    },
    "menuBarMetricOverride": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "hidden": { "type": "boolean" },
        "tint": { "type": "string", "enum": ["accent", "good", "warning", "danger", "secondary"] }
      },
      "additionalProperties": false
    },
    "stableMetricId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "jsonPath": {
      "description": "JSONPath-like path such as $.sources.files.items or $.transforms.visible.",
      "type": "string",
      "minLength": 1
    },
    "templateString": {
      "description": "String literal, optionally containing ${...} interpolation.",
      "type": "string"
    },
    "templateInteger": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/definitions/templateString"
        }
      ]
    },
    "templateBoolean": {
      "oneOf": [
        { "type": "boolean" },
        { "$ref": "#/definitions/templateString" }
      ]
    },
    "metricPrecision": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 3 },
        { "$ref": "#/definitions/templateString" }
      ]
    },
    "templateNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/definitions/templateString"
        }
      ]
    },
    "systemOptions": {
      "description": "Native system telemetry. Each requested group must appear in the manifest's permissions.system. Percentages are 0-100, byte counts are bytes, temperatures are degrees Celsius, and anything the machine does not publish is null.",
      "type": "object",
      "properties": {
        "metrics": {
          "description": "Groups to sample. Omitted means every group the widget is permitted to read.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "disk",
              "sensors",
              "network"
            ]
          },
          "uniqueItems": true
        },
        "detail": {
          "description": "Also emit cpu.cores[] and sensors.list[]. Roughly 4x the cost of a plain sample.",
          "$ref": "#/definitions/templateBoolean"
        },
        "sensors": {
          "description": "The sensor readings shown (`cpu`, `gpu`, `battery`, `power`, `fan`, `peak`, `all`…) or `key:<KEY>` for one specific sensor, returned as sensors.picked / sensors.pickedList. One value or a list; each may be a template so a menu-bar setting can narrow the sample.",
          "oneOf": [
            { "$ref": "#/definitions/templateString" },
            { "type": "array", "items": { "$ref": "#/definitions/templateString" } }
          ]
        },
        "io": {
          "description": "Also emit disk.read and disk.write (bytes/s). An IOKit registry walk per sample, so ask only while a rate is shown.",
          "$ref": "#/definitions/templateBoolean"
        },
        "mount": {
          "description": "Mount point the disk group reports on. Defaults to \"/\".",
          "$ref": "#/definitions/templateString"
        },
        "interface": {
          "description": "Network interface to sample. Omit it (or use all) to aggregate physical interfaces.",
          "$ref": "#/definitions/templateString"
        }
      },
      "additionalProperties": true
    }
  }
}
