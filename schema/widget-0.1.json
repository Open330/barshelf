{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://barshelf.jiun.dev/schema/widget-0.1.json",
  "title": "BarShelf Widget Manifest v0.1",
  "description": "Manifest schema for BarShelf widget.json files.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "icon",
    "bucket",
    "entry",
    "refresh"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "name": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "version": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "icon": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "bucket": {
      "$ref": "#/definitions/bucket"
    },
    "entry": {
      "$ref": "#/definitions/entry"
    },
    "source": {
      "$ref": "#/definitions/source"
    },
    "refresh": {
      "$ref": "#/definitions/refresh"
    },
    "statusItem": {
      "$ref": "#/definitions/statusItem"
    },
    "permissions": {
      "$ref": "#/definitions/permissions"
    },
    "settings": {
      "$ref": "#/definitions/settings"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entry": {
            "properties": {
              "kind": {
                "const": "exec"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "entry"
        ]
      },
      "then": {
        "required": [
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entry": {
            "properties": {
              "kind": {
                "const": "workflow"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "entry"
        ]
      },
      "then": {
        "properties": {
          "entry": {
            "required": [
              "main"
            ],
            "properties": {
              "main": {
                "description": "Workflow entry files are JSON workflow documents, typically workflow.json.",
                "type": "string",
                "minLength": 1,
                "pattern": "\\.json$"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "bucket": {
      "type": "object",
      "required": [
        "group",
        "order",
        "size"
      ],
      "properties": {
        "group": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "order": {
          "type": "integer"
        },
        "size": {
          "type": "string",
          "enum": [
            "XS",
            "S",
            "M",
            "L"
          ]
        },
        "pinned": {
          "description": "If true, the widget is initially pinned to the top pinned rows of the popover.",
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exec",
            "script",
            "workflow",
            "builtin"
          ]
        },
        "main": {
          "description": "Entry file relative to the widget bundle. Required for workflow entries.",
          "$ref": "#/definitions/nonEmptyString"
        },
        "runtime": {
          "description": "Optional runtime identifier such as workflow@1 or deno-ts@1.",
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "output"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exec",
            "script",
            "workflow",
            "builtin"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "discover": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "output": {
          "type": "string",
          "enum": [
            "viewtree",
            "data"
          ]
        },
        "adapter": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exec"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "output": {
                "const": "data"
              }
            }
          },
          "then": {
            "required": [
              "adapter"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "refresh": {
      "type": "object",
      "properties": {
        "onOpen": {
          "type": "boolean"
        },
        "interval": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "staleAfterSec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "deadlineField": {
          "description": "Reserved in v0.1. M1 adapters return nextRefreshAtMs instead of using this field.",
          "type": [
            "string",
            "null"
          ]
        },
        "watchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runInBackground": {
          "type": "boolean"
        },
        "popupOnly": {
          "description": "Allow automatic execution only from visible onOpen; manual refresh remains available.",
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "statusItem": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "icon",
            "text",
            "dynamic"
          ]
        },
        "icon": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/statusIcon"
            }
          ]
        },
        "labelFrom": {
          "type": "string"
        },
        "tooltipFrom": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "Default text drawn before the value in the menu bar (\"CPU\"). The user can override it, and a workflow's `status.prefix` takes precedence over it for widgets whose metric the user selects."
        },
        "style": {
          "type": "string",
          "enum": [
            "inline",
            "stacked",
            "metrics"
          ],
          "description": "`inline` draws the label beside the value; `stacked` puts it above; `metrics` draws up to two status.metrics readings. Stacked and metrics imply the widget's own status item."
        },
        "presentation": {
          "$ref": "#/definitions/menuBarPresentation"
        }
      },
      "additionalProperties": true,
      "description": "Menu-bar promotion. `none` keeps the widget out of the menu bar; `icon`, `text` and `dynamic` make it eligible, and the user's per-widget toggle decides. The live text is the widget's own status label (a workflow's `status.label`, or a script's `host.render` status), so `labelFrom` / `tooltipFrom` are accepted but unused."
    },
    "menuBarPresentation": {
      "description": "Sparse author defaults for a promoted menu-bar item. User preferences override each field, then a workflow/script render can override these defaults.",
      "type": "object",
      "properties": {
        "showValues": { "type": "boolean" },
        "showUnits": { "type": "boolean" },
        "precision": { "type": "integer", "minimum": 0, "maximum": 3 },
        "color": { "type": "string", "enum": ["automatic", "monochrome", "accent", "good", "warning", "danger", "secondary"] },
        "valueWidth": { "type": "number", "minimum": 32, "maximum": 120, "description": "Text column width in points for width: fixed." },
        "width": { "type": "string", "enum": ["auto", "fixed", "fit"], "description": "auto (default) reserves room for `digits` integer digits so a reading does not change the item's width; fixed uses valueWidth; fit follows the text." },
        "digits": { "type": "integer", "minimum": 1, "maximum": 6, "description": "Integer digits width: auto reserves (default 2)." },
        "alignment": { "type": "string", "enum": ["leading", "center", "trailing"], "description": "Block alignment of the label and value rows. Numbers are always right-aligned within their reserved digits." },
        "weight": { "type": "string", "enum": ["regular", "medium", "semibold", "bold"] },
        "size": { "type": "string", "enum": ["small", "regular", "large"] },
        "metricOrder": {
          "type": "array",
          "items": { "$ref": "#/definitions/stableMetricId" },
          "uniqueItems": true
        },
        "metricOverrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/stableMetricId" },
          "additionalProperties": { "$ref": "#/definitions/menuBarMetricOverride" }
        }
      },
      "additionalProperties": false
    },
    "menuBarMetricOverride": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "hidden": { "type": "boolean" },
        "tint": { "type": "string", "enum": ["accent", "good", "warning", "danger", "secondary"] }
      },
      "additionalProperties": false
    },
    "stableMetricId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "statusIcon": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "sfSymbol",
            "asset"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "properties": {
        "exec": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/execPermission"
          }
        },
        "network": {
          "type": "array",
          "items": {}
        },
        "readPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": false,
        "storage": {
          "$ref": "#/definitions/storagePermission"
        },
        "notifications": {
          "type": "boolean"
        },
        "env": {
          "description": "Environment variable names that may be read by the host or passed to the primary source command.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keychain": {
          "type": "boolean"
        },
        "system": {
          "description": "System telemetry groups a `system` workflow source may read. An undeclared group fails the refresh.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "disk",
              "sensors",
              "network"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "storagePermission": {
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 0
        },
        "secrets": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "execPermission": {
      "type": "object",
      "required": [
        "command",
        "allowedArgs"
      ],
      "properties": {
        "command": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "allowedArgs": {
          "description": "Allowed argv tails. A literal '*' item matches exactly one argument.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/argPattern"
          }
        },
        "env": {
          "description": "Environment variable names allowed for this command.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sensitiveOutput": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "argPattern": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/setting"
      }
    },
    "setting": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "title": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "enum",
            "directory",
            "select",
            "path"
          ]
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "items": {}
        },
        "optionTitles": {
          "description": "Display labels for `options`, positionally. Ignored unless it has exactly as many entries as `options`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "permission": {
          "description": "Permission id associated with this setting, for example a directory picker backing an fs.directory source.",
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
